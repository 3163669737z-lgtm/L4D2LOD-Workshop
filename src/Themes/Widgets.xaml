<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ════════════════════════════════════════════════════════════════════
         Widgets.xaml —— 自绘控件/浮层专用资源（现代毛玻璃对话框样式）
         ════════════════════════════════════════════════════════════════════ -->

    <Style x:Key="Widget.Dialog.Mask" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.Mask}" />
    </Style>

    <Style x:Key="Widget.Dialog.Panel" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.GlassElevated}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.PrismBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="24" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="Widget.Dialog.DetailBox" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Brush.GlassSunken}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <Style x:Key="Widget.Dialog.Title" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.ArtDisplay}" />
        <Setter Property="FontSize" Value="{DynamicResource FS.PageTitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>

    <Style x:Key="Widget.Dialog.Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Cjk}" />
        <Setter Property="FontSize" Value="{DynamicResource FS.Body}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.InkSoft}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="LineHeight" Value="20" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>

    <Style x:Key="Widget.Dialog.Label" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Cjk}" />
        <Setter Property="FontSize" Value="{DynamicResource FS.Small}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.InkSoft}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>

    <Style x:Key="Widget.Dialog.Error" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Cjk}" />
        <Setter Property="FontSize" Value="{DynamicResource FS.Small}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Err}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>

    <Style x:Key="Widget.Dialog.DetailText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Mono}" />
        <Setter Property="FontSize" Value="{DynamicResource FS.Mono}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Ideal" />
    </Style>

    <Style x:Key="Widget.Dialog.Button" TargetType="Button">
        <Setter Property="Height" Value="34" />
        <Setter Property="MinWidth" Value="92" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Cjk}" />
        <Setter Property="FontSize" Value="{DynamicResource FS.Body}" />
        <Setter Property="Padding" Value="16,0,16,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
    </Style>

</ResourceDictionary>
