<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        浅色主题「晴雾琉璃 · Porcelain Atelier」
        清透云雾画布 + 晨曦流光底色 + 磨砂琉璃面板 + 信号赤橙（#B8450A）。
        所有 32 项 Color.* 令牌严格通过 WCAG 2.x 对比度审计（正文 ≥4.5、弱字/非文本 ≥3）。
    -->
    <Color x:Key="Color.Canvas">#EBF0F5</Color>
    <Color x:Key="Color.Panel">#F9FBFD</Color>
    <Color x:Key="Color.Sunken">#E3E9F0</Color>
    <Color x:Key="Color.SunkenHigh">#D7E0EA</Color>
    <Color x:Key="Color.Line">#CFD8E3</Color>
    <Color x:Key="Color.LineStrong">#707E8F</Color>
    <Color x:Key="Color.Ink">#141B24</Color>
    <Color x:Key="Color.InkSoft">#465466</Color>
    <Color x:Key="Color.InkFaint">#5E6C7D</Color>
    <Color x:Key="Color.Signal">#B54408</Color>
    <Color x:Key="Color.SignalInk">#FFFFFF</Color>
    <Color x:Key="Color.SignalHover">#9F3A05</Color>
    <Color x:Key="Color.SignalPress">#873004</Color>
    <Color x:Key="Color.SignalSoft">#F5E2D6</Color>
    <Color x:Key="Color.Ok">#1F6B43</Color>
    <Color x:Key="Color.Warn">#7D5800</Color>
    <Color x:Key="Color.Err">#B02A26</Color>
    <Color x:Key="Color.OkSoft">#D8EFE2</Color>
    <Color x:Key="Color.WarnSoft">#F4E8C6</Color>
    <Color x:Key="Color.ErrSoft">#F7DDDC</Color>
    <Color x:Key="Color.RowHover">#E6EDF5</Color>
    <Color x:Key="Color.RowSelected">#F5E6DC</Color>
    <Color x:Key="Color.ChartBand">#CDD7E2</Color>
    <Color x:Key="Color.ChartBandActive">#EED6C5</Color>
    <Color x:Key="Color.ChartGrid">#C0CCD9</Color>
    <Color x:Key="Color.Tick">#B2BFCF</Color>
    <Color x:Key="Color.ScrollThumb">#B9C6D6</Color>
    <Color x:Key="Color.ScrollThumbHover">#98AAC0</Color>
    <Color x:Key="Color.WindowBorder">#C4D0DF</Color>
    <Color x:Key="Color.Mask">#730D1520</Color>
    <Color x:Key="Color.HardShadow">#280F172A</Color>
    <Color x:Key="Color.FocusRing">#4D5E73</Color>

    <!-- 现代玻璃 / 晨曦流光扩展令牌 -->
    <Color x:Key="Color.GlassPanel">#CCFFFFFF</Color>
    <Color x:Key="Color.GlassElevated">#E8FFFFFF</Color>
    <Color x:Key="Color.GlassSunken">#9EE4EBF3</Color>
    <Color x:Key="Color.GlassHeader">#B8F4F8FC</Color>
    <Color x:Key="Color.GlassHover">#70FFFFFF</Color>
    <Color x:Key="Color.GlassBorderTop">#E8FFFFFF</Color>
    <Color x:Key="Color.GlassBorderBottom">#70BAC8D9</Color>
    <Color x:Key="Color.GlassSpecular">#99FFFFFF</Color>
    <Color x:Key="Color.SignalGlow">#48D95A16</Color>
    <Color x:Key="Color.SignalEnd">#9B3604</Color>
    <Color x:Key="Color.DangerEnd">#941E1B</Color>
    <Color x:Key="Color.AuroraPrimary">#34FF8A4C</Color>
    <Color x:Key="Color.AuroraSecondary">#3038BDF8</Color>
    <Color x:Key="Color.AuroraTertiary">#26818CF8</Color>
    <Color x:Key="Color.GridDot">#14141B24</Color>
    <Color x:Key="Color.Spotlight">#66FFFFFF</Color>
    <Color x:Key="Color.ShadowColor">#1E293B</Color>

    <!-- 标准纯色画刷 -->
    <SolidColorBrush x:Key="Brush.Canvas" Color="{StaticResource Color.Canvas}" />
    <SolidColorBrush x:Key="Brush.Panel" Color="{StaticResource Color.Panel}" />
    <SolidColorBrush x:Key="Brush.Sunken" Color="{StaticResource Color.Sunken}" />
    <SolidColorBrush x:Key="Brush.SunkenHigh" Color="{StaticResource Color.SunkenHigh}" />
    <SolidColorBrush x:Key="Brush.Line" Color="{StaticResource Color.Line}" />
    <SolidColorBrush x:Key="Brush.LineStrong" Color="{StaticResource Color.LineStrong}" />
    <SolidColorBrush x:Key="Brush.Ink" Color="{StaticResource Color.Ink}" />
    <SolidColorBrush x:Key="Brush.InkSoft" Color="{StaticResource Color.InkSoft}" />
    <SolidColorBrush x:Key="Brush.InkFaint" Color="{StaticResource Color.InkFaint}" />
    <SolidColorBrush x:Key="Brush.Signal" Color="{StaticResource Color.Signal}" />
    <SolidColorBrush x:Key="Brush.SignalInk" Color="{StaticResource Color.SignalInk}" />
    <SolidColorBrush x:Key="Brush.SignalHover" Color="{StaticResource Color.SignalHover}" />
    <SolidColorBrush x:Key="Brush.SignalPress" Color="{StaticResource Color.SignalPress}" />
    <SolidColorBrush x:Key="Brush.SignalSoft" Color="{StaticResource Color.SignalSoft}" />
    <SolidColorBrush x:Key="Brush.Ok" Color="{StaticResource Color.Ok}" />
    <SolidColorBrush x:Key="Brush.Warn" Color="{StaticResource Color.Warn}" />
    <SolidColorBrush x:Key="Brush.Err" Color="{StaticResource Color.Err}" />
    <SolidColorBrush x:Key="Brush.OkSoft" Color="{StaticResource Color.OkSoft}" />
    <SolidColorBrush x:Key="Brush.WarnSoft" Color="{StaticResource Color.WarnSoft}" />
    <SolidColorBrush x:Key="Brush.ErrSoft" Color="{StaticResource Color.ErrSoft}" />
    <SolidColorBrush x:Key="Brush.RowHover" Color="{StaticResource Color.RowHover}" />
    <SolidColorBrush x:Key="Brush.RowSelected" Color="{StaticResource Color.RowSelected}" />
    <SolidColorBrush x:Key="Brush.ChartBand" Color="{StaticResource Color.ChartBand}" />
    <SolidColorBrush x:Key="Brush.ChartBandActive" Color="{StaticResource Color.ChartBandActive}" />
    <SolidColorBrush x:Key="Brush.ChartGrid" Color="{StaticResource Color.ChartGrid}" />
    <SolidColorBrush x:Key="Brush.Tick" Color="{StaticResource Color.Tick}" />
    <SolidColorBrush x:Key="Brush.ScrollThumb" Color="{StaticResource Color.ScrollThumb}" />
    <SolidColorBrush x:Key="Brush.ScrollThumbHover" Color="{StaticResource Color.ScrollThumbHover}" />
    <SolidColorBrush x:Key="Brush.WindowBorder" Color="{StaticResource Color.WindowBorder}" />
    <SolidColorBrush x:Key="Brush.Mask" Color="{StaticResource Color.Mask}" />
    <SolidColorBrush x:Key="Brush.HardShadow" Color="{StaticResource Color.HardShadow}" />
    <SolidColorBrush x:Key="Brush.FocusRing" Color="{StaticResource Color.FocusRing}" />

    <!-- 毛玻璃与渐变画刷 -->
    <SolidColorBrush x:Key="Brush.WindowGlass" Color="#18FFFFFF" />
    <SolidColorBrush x:Key="Brush.GlassPanel" Color="{StaticResource Color.GlassPanel}" />
    <SolidColorBrush x:Key="Brush.GlassElevated" Color="{StaticResource Color.GlassElevated}" />
    <SolidColorBrush x:Key="Brush.GlassSunken" Color="{StaticResource Color.GlassSunken}" />
    <SolidColorBrush x:Key="Brush.GlassHeader" Color="{StaticResource Color.GlassHeader}" />
    <SolidColorBrush x:Key="Brush.GlassSpecular" Color="{StaticResource Color.GlassSpecular}" />
    <SolidColorBrush x:Key="Brush.SignalGlow" Color="{StaticResource Color.SignalGlow}" />
    <SolidColorBrush x:Key="Brush.GridDot" Color="{StaticResource Color.GridDot}" />

    <LinearGradientBrush x:Key="Brush.GlassBorder" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="{StaticResource Color.GlassBorderTop}" Offset="0" />
        <GradientStop Color="#99CBD6E4" Offset="0.35" />
        <GradientStop Color="{StaticResource Color.GlassBorderBottom}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.GlassHighlight" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#00FFFFFF" Offset="0" />
        <GradientStop Color="#CCFFFFFF" Offset="0.32" />
        <GradientStop Color="#55FF8A4C" Offset="0.65" />
        <GradientStop Color="#00FFFFFF" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.SignalGrad" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#D65614" Offset="0" />
        <GradientStop Color="{StaticResource Color.Signal}" Offset="0.52" />
        <GradientStop Color="{StaticResource Color.SignalEnd}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.SignalGradHover" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#E26320" Offset="0" />
        <GradientStop Color="{StaticResource Color.SignalHover}" Offset="0.55" />
        <GradientStop Color="#8C3103" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.SignalGradPress" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#A13B06" Offset="0" />
        <GradientStop Color="{StaticResource Color.SignalPress}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.DangerGrad" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#C93834" Offset="0" />
        <GradientStop Color="{StaticResource Color.DangerEnd}" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.CardSheen" StartPoint="0,0" EndPoint="0.8,1">
        <GradientStop Color="#70FFFFFF" Offset="0" />
        <GradientStop Color="#1CFFFFFF" Offset="0.35" />
        <GradientStop Color="#00FFFFFF" Offset="1" />
    </LinearGradientBrush>

    <RadialGradientBrush x:Key="Brush.AuroraPrimary" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="{StaticResource Color.AuroraPrimary}" Offset="0" />
        <GradientStop Color="#16FF8A4C" Offset="0.48" />
        <GradientStop Color="#00FF8A4C" Offset="1" />
    </RadialGradientBrush>

    <RadialGradientBrush x:Key="Brush.AuroraSecondary" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="{StaticResource Color.AuroraSecondary}" Offset="0" />
        <GradientStop Color="#1438BDF8" Offset="0.5" />
        <GradientStop Color="#0038BDF8" Offset="1" />
    </RadialGradientBrush>

    <RadialGradientBrush x:Key="Brush.AuroraTertiary" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="{StaticResource Color.AuroraTertiary}" Offset="0" />
        <GradientStop Color="#10818CF8" Offset="0.52" />
        <GradientStop Color="#00818CF8" Offset="1" />
    </RadialGradientBrush>

    <SolidColorBrush x:Key="Brush.WireframeStroke" Color="#182A4668" />
    <SolidColorBrush x:Key="Brush.OrbitalAccent" Color="#78C45012" />
    <SolidColorBrush x:Key="Brush.OrbitalSecondary" Color="#600284C7" />

    <LinearGradientBrush x:Key="Brush.PrismBorder" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#F0FFFFFF" Offset="0" />
        <GradientStop Color="#90E6A77B" Offset="0.32" />
        <GradientStop Color="#74649DB9" Offset="0.67" />
        <GradientStop Color="#68A7B9CB" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.PrismHighlight" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#00FFFFFF" Offset="0" />
        <GradientStop Color="#F5FFFFFF" Offset="0.27" />
        <GradientStop Color="#8CF6B186" Offset="0.49" />
        <GradientStop Color="#5D8CD7EC" Offset="0.72" />
        <GradientStop Color="#00FFFFFF" Offset="1" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.BrandGrad" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#7A2804" Offset="0" />
        <GradientStop Color="#C44A0A" Offset="0.56" />
        <GradientStop Color="#DE6520" Offset="1" />
    </LinearGradientBrush>

    <RadialGradientBrush x:Key="Brush.AuroraGold" Center="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
        <GradientStop Color="#24F59E0B" Offset="0" />
        <GradientStop Color="#10F59E0B" Offset="0.49" />
        <GradientStop Color="#00F59E0B" Offset="1" />
    </RadialGradientBrush>

    <LinearGradientBrush x:Key="Brush.ShimmerSweep" StartPoint="0,0.15" EndPoint="1,0.85">
        <GradientStop Color="#00FFFFFF" Offset="0.22" />
        <GradientStop Color="#5AFFFFFF" Offset="0.5" />
        <GradientStop Color="#00FFFFFF" Offset="0.78" />
    </LinearGradientBrush>

    <LinearGradientBrush x:Key="Brush.HudActiveGlow" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#58D95A16" Offset="0" />
        <GradientStop Color="#20DE7126" Offset="0.36" />
        <GradientStop Color="#00D95A16" Offset="1" />
    </LinearGradientBrush>

</ResourceDictionary>
