<pages:StudioPageBase x:Class="LodStudio.Views.Pages.ToolkitPage"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:pages="clr-namespace:LodStudio.Views.Pages"
                      xmlns:controls="clr-namespace:LodStudio.Controls"
                      FontFamily="{DynamicResource Font.Cjk}" FontSize="{DynamicResource FS.Body}"
                      UseLayoutRounding="True" SnapsToDevicePixels="True">
    <pages:StudioPageBase.Resources>
        <Style x:Key="Toolkit.StatusDot" TargetType="Ellipse">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="Margin" Value="0,0,7,0" />
            <Setter Property="Fill" Value="{DynamicResource Brush.InkFaint}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <Trigger Property="Tag" Value="Ok"><Setter Property="Fill" Value="{DynamicResource Brush.Ok}" /></Trigger>
                <Trigger Property="Tag" Value="Warn"><Setter Property="Fill" Value="{DynamicResource Brush.Warn}" /></Trigger>
                <Trigger Property="Tag" Value="Err"><Setter Property="Fill" Value="{DynamicResource Brush.Err}" /></Trigger>
                <Trigger Property="Tag" Value="Signal"><Setter Property="Fill" Value="{DynamicResource Brush.Signal}" /></Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Toolkit.ReportBox" TargetType="TextBox" BasedOn="{StaticResource Input.Mono}">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Frame" Background="{TemplateBinding Background}" CornerRadius="8"
                                BorderThickness="{TemplateBinding BorderThickness}" BorderBrush="{TemplateBinding BorderBrush}">
                            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"
                                          HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource Brush.FocusRing}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </pages:StudioPageBase.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,14">
            <TextBlock Style="{StaticResource Studio.PageEyebrow}" Text="TOOLKIT" />
            <TextBlock Style="{StaticResource Studio.PageTitle}" Margin="0,3,0,4" Text="维护与环境" />
            <TextBlock Style="{StaticResource Studio.PageSub}" Text="随时把修改过的 QC 还原回原样、清理残留的无用 LOD 文件，或给编译器与本地运行环境做一次全面体检。" />
            <Border Style="{StaticResource Studio.SubTabHost}" HorizontalAlignment="Left" Margin="0,14,0,0">
                <Grid x:Name="SubTabTrack" ClipToBounds="True">
                    <Border x:Name="SubTabIndicator" Style="{StaticResource Studio.SubTabIndicator}" />
                    <StackPanel x:Name="SubTabButtons" Orientation="Horizontal">
                        <Button Style="{StaticResource Studio.SubTabButton}" Content="备份、报告与清理" />
                        <Button Style="{StaticResource Studio.SubTabButton}" Margin="4,0,0,0" Content="编译器与环境体检" />
                    </StackPanel>
                </Grid>
            </Border>
        </StackPanel>
        <ScrollViewer x:Name="SubPageScroll" Grid.Row="1" HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
            <Grid Margin="0,0,8,0">
                <StackPanel x:Name="MaintenancePanel">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="RestoreCard" Style="{StaticResource Studio.HeroActionCard}">
                            <DockPanel>
                                <Button DockPanel.Dock="Bottom" Style="{StaticResource Btn.Primary}" HorizontalAlignment="Left"
                                        Margin="0,12,0,0" Content="选择目录并还原…" Click="OnRestoreClick" />
                                <StackPanel>
                                    <controls:Icon x:Name="RestoreIcon" Kind="Restore" Size="25" HorizontalAlignment="Left"
                                                   IconBrush="{DynamicResource Brush.Signal}" />
                                    <TextBlock Style="{StaticResource Studio.SectionTitle}" Margin="0,8,0,4" Text="一键还原原始 QC" />
                                    <TextBlock Style="{StaticResource Studio.PageSub}"
                                               Text="不满意当前的远景效果？选中工程目录，就能把 .lodbak 备份里的原始 QC 安全恢复回去。" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                        <Border x:Name="CleanCard" Grid.Column="2" Style="{StaticResource Studio.HeroActionCard}">
                            <DockPanel>
                                <Button DockPanel.Dock="Bottom" Style="{StaticResource Btn.Secondary}" HorizontalAlignment="Left"
                                        Margin="0,12,0,0" Content="扫描并清理冗余文件…" Click="OnCleanClick" />
                                <StackPanel>
                                    <controls:Icon x:Name="CleanIcon" Kind="Trash" Size="25" HorizontalAlignment="Left"
                                                   IconBrush="{DynamicResource Brush.Signal}" />
                                    <TextBlock Style="{StaticResource Studio.SectionTitle}" Margin="0,8,0,4" Text="清理未引用的旧 LOD 文件" />
                                    <TextBlock Style="{StaticResource Studio.PageSub}"
                                               Text="自动核对目录里所有 QC 的引用关系，找出不再使用的残留 _lod 模型文件，确认后再安全清理。" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </Grid>

                    <Border x:Name="BackupCard" Style="{StaticResource Studio.SectionCard}">
                        <StackPanel>
                            <CheckBox x:Name="BackupToggle" Style="{StaticResource Studio.ToggleSwitch}"
                                      Content="修改 QC 前自动备份原文件" Click="OnBackupClick" />
                            <TextBlock Style="{StaticResource Studio.PageSub}"
                                       Text="会在改写前生成 .lodbak 备份，且永不覆盖最初的原始备份，随时可以反悔。" />
                            <Border x:Name="BackupDetails" Style="{StaticResource Studio.TreeChildContainer}" Visibility="Collapsed">
                                <Grid>
                                    <Control Style="{StaticResource Studio.TreeBranch}" />
                                    <StackPanel>
                                        <Label Style="{StaticResource Studio.FieldLabel}" Target="{Binding ElementName=BackupLocation}"
                                               Content="备份文件存放在哪里" />
                                        <ComboBox x:Name="BackupLocation" Style="{StaticResource Combo.Base}" Margin="0,6,0,0"
                                                  HorizontalAlignment="Left" MinWidth="230" SelectionChanged="OnBackupLocationChanged">
                                            <ComboBoxItem Content="紧挨着原 QC 文件" />
                                            <ComboBoxItem Content="软件旁的「LOD备份」文件夹" />
                                            <ComboBoxItem Content="指定专门的备份目录" />
                                        </ComboBox>
                                        <Border x:Name="BackupCustom" Style="{StaticResource Studio.TreeChildContainer}"
                                                Background="{DynamicResource Brush.GlassPanel}" Visibility="Collapsed">
                                            <Grid>
                                                <Control Style="{StaticResource Studio.TreeBranch}" />
                                                <StackPanel>
                                                    <DockPanel>
                                                        <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Secondary}" Margin="8,0,0,0"
                                                                Content="浏览…" Click="OnBrowseBackupClick" />
                                                        <TextBox x:Name="BackupPath" Style="{StaticResource Input.Mono}"
                                                                 Tag="输入或选择备份目录" AutomationProperties.Name="自定义备份目录" />
                                                    </DockPanel>
                                                    <TextBlock Style="{StaticResource Studio.PageSub}" Margin="0,6,0,0"
                                                               Text="会按工程目录结构镜像保存，方便整包还原。" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <Border x:Name="BackupWarning" Margin="0,8,0,0" Padding="10,5" CornerRadius="8"
                                    Background="{DynamicResource Brush.WarnSoft}" Visibility="Collapsed">
                                <TextBlock Style="{StaticResource Studio.PageSub}" Foreground="{DynamicResource Brush.Ink}"
                                           Text="已关闭自动备份：后续改写 QC 将无法一键还原，建议保持开启。" />
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border x:Name="ReportCard" Style="{StaticResource Studio.SectionCard}">
                        <StackPanel>
                            <Label Style="{StaticResource Studio.FieldLabel}" Target="{Binding ElementName=ReportLocation}"
                                   FontWeight="SemiBold" Content="运行报告与详细日志存放位置" />
                            <TextBlock Style="{StaticResource Studio.PageSub}" Margin="0,4,0,0"
                                       Text="每次处理完成后自动生成可读的 Markdown 总结报告和运行日志，目录不可写时会自动回退到 QC 旁边。" />
                            <ComboBox x:Name="ReportLocation" Style="{StaticResource Combo.Base}" Margin="0,8,0,0"
                                      HorizontalAlignment="Left" MinWidth="230" SelectionChanged="OnReportLocationChanged">
                                <ComboBoxItem Content="紧挨着原 QC 目录" />
                                <ComboBoxItem Content="软件旁的「LOD日志报告」文件夹" />
                                <ComboBoxItem Content="指定专门目录" />
                            </ComboBox>
                            <Border x:Name="ReportCustom" Style="{StaticResource Studio.TreeChildContainer}" Visibility="Collapsed">
                                <Grid>
                                    <Control Style="{StaticResource Studio.TreeBranch}" />
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Secondary}" Margin="8,0,0,0"
                                                Content="浏览…" Click="OnBrowseReportClick" />
                                        <TextBox x:Name="ReportPath" Style="{StaticResource Input.Mono}"
                                                 Tag="输入或选择报告目录" AutomationProperties.Name="自定义报告目录" />
                                    </DockPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel x:Name="EnvironmentPanel" Visibility="Collapsed">
                    <UniformGrid Columns="3">
                        <Border x:Name="ReductionStatusCard" Style="{StaticResource Studio.SectionCard}" Margin="0,0,8,12">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Studio.SectionTitle}" Text="内置减面引擎" />
                                <DockPanel Margin="0,6,0,4">
                                    <Ellipse Style="{StaticResource Toolkit.StatusDot}" Tag="{Binding ReductionTone}" />
                                    <TextBlock Style="{StaticResource Studio.PageSub}" Foreground="{DynamicResource Brush.Ink}"
                                               Text="{Binding ReductionText}" />
                                </DockPanel>
                                <TextBlock Style="{StaticResource Studio.PageSub}" Text="内嵌 meshoptimizer，无需安装 Blender。" />
                            </StackPanel>
                        </Border>
                        <Border x:Name="CompilerStatusCard" Style="{StaticResource Studio.SectionCard}" Margin="4,0,4,12">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Studio.SectionTitle}" Text="模型编译器" />
                                <DockPanel Margin="0,6,0,4">
                                    <Ellipse Style="{StaticResource Toolkit.StatusDot}" Tag="{Binding CompilerTone}" />
                                    <TextBlock Style="{StaticResource Studio.PageSub}" Foreground="{DynamicResource Brush.Ink}"
                                               Text="{Binding CompilerText}" />
                                </DockPanel>
                                <TextBlock Style="{StaticResource Studio.PageSub}" Text="仅开启试编译时才需要 nekomdl.exe。" />
                            </StackPanel>
                        </Border>
                        <Border x:Name="PermissionStatusCard" Style="{StaticResource Studio.SectionCard}" Margin="8,0,0,12">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Studio.SectionTitle}" Text="目录写入权限" />
                                <DockPanel Margin="0,6,0,4">
                                    <Ellipse Style="{StaticResource Toolkit.StatusDot}" Tag="{Binding PermissionTone}" />
                                    <TextBlock Style="{StaticResource Studio.PageSub}" Foreground="{DynamicResource Brush.Ink}"
                                               Text="{Binding PermissionText}" />
                                </DockPanel>
                                <TextBlock Style="{StaticResource Studio.PageSub}" Text="确保能够正常写出模型与配置。" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>

                    <Border x:Name="CompilerCard" Style="{StaticResource Studio.SectionCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Studio.SectionTitle}" Text="编译器路径" />
                            <DockPanel Margin="0,8,0,0">
                                <Button DockPanel.Dock="Right" x:Name="FindCompilerButton" Style="{StaticResource Btn.Secondary}"
                                        Margin="8,0,0,0" Content="自动查找" Click="OnFindCompilerClick" />
                                <Button DockPanel.Dock="Right" x:Name="BrowseCompilerButton" Style="{StaticResource Btn.Secondary}"
                                        Margin="8,0,0,0" Content="浏览…" Click="OnBrowseCompilerClick" />
                                <TextBox x:Name="CompilerPath" Style="{StaticResource Input.Mono}" IsReadOnly="True"
                                         Tag="还没有指定 nekomdl.exe" AutomationProperties.Name="编译器路径" />
                            </DockPanel>
                            <DockPanel Margin="0,6,0,0">
                                <Ellipse x:Name="CompilerPathDot" Style="{StaticResource Toolkit.StatusDot}" />
                                <TextBlock x:Name="CompilerPathStatus" Style="{StaticResource Studio.PageSub}" />
                            </DockPanel>
                        </StackPanel>
                    </Border>

                    <Border x:Name="DiagnosticsCard" Style="{StaticResource Studio.SectionCard}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Studio.SectionTitle}" Text="一键环境体检" />
                            <WrapPanel Margin="0,9,0,2">
                                <Button x:Name="RunDiagnosticsButton" Style="{StaticResource Btn.Primary}" Margin="0,0,8,6"
                                        Content="立即运行环境体检" Click="OnRunDiagnosticsClick" />
                                <Button x:Name="CopyReportButton" Style="{StaticResource Btn.Secondary}" Margin="0,0,8,6"
                                        Content="复制体检报告" Click="OnCopyReportClick" IsEnabled="False" />
                                <Button Style="{StaticResource Btn.Ghost}" Margin="0,0,0,6" Content="打开配置文件夹"
                                        Click="OnOpenSettingsClick" />
                            </WrapPanel>
                            <DockPanel>
                                <Ellipse x:Name="DiagnosticsDot" Style="{StaticResource Toolkit.StatusDot}" />
                                <TextBlock x:Name="DiagnosticsStatus" Style="{StaticResource Studio.PageSub}" Text="尚未运行体检" />
                            </DockPanel>
                            <TextBox x:Name="DiagnosticsReport" Style="{StaticResource Toolkit.ReportBox}" Margin="0,6,0,0"
                                     Height="196" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto" AutomationProperties.Name="环境体检报告" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</pages:StudioPageBase>
