<settings:SettingsPageBase x:Class="LodStudio.Views.Settings.SettingsPageEngine"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:LodStudio.Controls"
        xmlns:settings="clr-namespace:LodStudio.Views.Settings"
        Background="Transparent">

    <settings:SettingsPageBase.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Views/Settings/SettingsKit.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </settings:SettingsPageBase.Resources>

    <StackPanel>
        <TextBlock Text="引擎" Style="{StaticResource Set.PageTitle}" />
        <TextBlock Text="减面用的是内置引擎。想在生成后试编译，可以在这里设置编译器。"
                   Style="{StaticResource Set.PageSub}" Margin="0,3,0,0" />
        <controls:Rule Margin="0,14,0,0" />

        <TextBlock Text="内置减面引擎" Style="{StaticResource Set.GroupTitle}" Margin="0,14,0,0" />
        <TextBlock Text="meshoptimizer 会分开处理各个相连的部件，保留开放边界和轮廓的关键点。"
                   Style="{StaticResource Set.Hint}" Margin="0,5,0,0" />

        <!-- ═══════════ 编译器 ═══════════ -->
        <controls:Rule Margin="0,16,0,0" />
        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
            <TextBlock Text="编译器" Style="{StaticResource Set.GroupTitle}" />
            <Border Style="{StaticResource Set.Tag}" Margin="8,1,0,0">
                <TextBlock Text="可选" FontSize="{StaticResource FS.Micro}"
                           Foreground="{DynamicResource Brush.InkSoft}" />
            </Border>
        </StackPanel>
        <TextBlock Text="开启「生成后试编译」才需要 nekomdl.exe。通常能在 studiomdl 旁边找到它。"
                   Style="{StaticResource Set.Hint}" Margin="0,3,0,0" />

        <TextBlock Text="nekomdl.exe 路径" Style="{StaticResource Set.Label}" Margin="0,10,0,0" />
        <Grid Margin="0,6,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBox x:Name="TxtCompilerPath" Grid.Column="0" Style="{StaticResource Input.Mono}"
                     IsReadOnly="True" Height="30" VerticalContentAlignment="Center"
                     Tag="还没选编译器，可浏览或自动查找" ToolTipService.ShowDuration="30000" />
            <Button x:Name="BtnBrowseCompiler" Grid.Column="1" Style="{StaticResource Set.SmallButton}"
                    Content="浏览…" Margin="8,0,0,0" ToolTip="选择 nekomdl.exe" />
            <Button x:Name="BtnFindCompiler" Grid.Column="2" Style="{StaticResource Set.SmallGhostButton}"
                    Content="自动查找" Margin="4,0,0,0" ToolTip="到 Steam 库和常见的工具文件夹里找" />
        </Grid>

        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <Ellipse x:Name="DotCompiler" Width="5" Height="5" VerticalAlignment="Center"
                     Fill="{DynamicResource Brush.InkFaint}" />
            <TextBlock x:Name="TxtCompilerStatus" Style="{StaticResource Text.Small}" Margin="7,0,0,0"
                       VerticalAlignment="Center" Text="未设置" />
        </StackPanel>

    </StackPanel>

</settings:SettingsPageBase>
