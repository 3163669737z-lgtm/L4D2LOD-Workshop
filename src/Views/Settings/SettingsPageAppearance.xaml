<settings:SettingsPageBase x:Class="LodStudio.Views.Settings.SettingsPageAppearance"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:LodStudio.Controls"
        xmlns:settings="clr-namespace:LodStudio.Views.Settings"
        Background="Transparent">

    <settings:SettingsPageBase.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Views/Settings/SettingsKit.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </settings:SettingsPageBase.Resources>

    <StackPanel MinWidth="540">
        <TextBlock Text="外观" Style="{StaticResource Set.PageTitle}" />
        <TextBlock Text="选一个看着舒服的主题，也可以调节界面动效。下方可以预览当前配色。"
                   Style="{StaticResource Set.PageSub}" Margin="0,3,0,0" />

        <!-- ═══════════ 主题 ═══════════ -->
        <TextBlock Text="主题" Style="{StaticResource Set.GroupTitle}" Margin="0,10,0,0" />
        <settings:SettingRow Title="配色模式" Hint="选「跟随系统」，主题就会随 Windows 的应用模式切换。">
            <Border Style="{StaticResource Set.FocusFrame}">
                <controls:Segmented x:Name="SegTheme" Variant="Boxed" Height="30" FontSize="11.5" ItemPadding="14" />
            </Border>
        </settings:SettingRow>

        <CheckBox x:Name="ChkAnimations" Style="{StaticResource Set.Toggle}" Margin="0,2,0,0">
            <StackPanel>
                <TextBlock Text="界面动效" Style="{StaticResource Set.Label}" />
                <TextBlock x:Name="TxtAnimHint" Style="{StaticResource Set.Hint}" Margin="0,2,0,0"
                           Text="开启后会有玻璃高光、页面切换和控件动效。" />
            </StackPanel>
        </CheckBox>

        <!-- ═══════════ 主题示意 ═══════════ -->
        <controls:Rule Margin="0,6,0,0" />
        <TextBlock Text="主题预览" Style="{StaticResource Set.GroupTitle}" Margin="0,7,0,0" />

        <Border Style="{StaticResource Set.Card}" Margin="0,6,0,0" Padding="14,8">
            <StackPanel>
                <Border Background="{DynamicResource Brush.GlassElevated}" BorderBrush="{DynamicResource Brush.PrismBorder}"
                        BorderThickness="1" CornerRadius="7" Padding="9,0,9,1" Margin="0,0,0,7">
                    <TextBlock Foreground="{DynamicResource Brush.InkSoft}" TextTrimming="CharacterEllipsis">
                        <Run Text="远景曜境" FontFamily="{DynamicResource Font.ArtDisplay}" FontSize="15"
                             FontWeight="SemiBold" Foreground="{DynamicResource Brush.Ink}" /><Run Text="&#160; · &#160;" />
                        <Run Text="FARSIGHT ATELIER" FontFamily="{DynamicResource Font.ArtLatin}" FontSize="10"
                             FontWeight="SemiBold" /><Run Text="&#160; · &#160;" />
                        <Run Text="Precision Silhouette" FontFamily="{DynamicResource Font.Script}" FontSize="17"
                             Foreground="{DynamicResource Brush.Signal}" />
                    </TextBlock>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <Border Style="{StaticResource Set.Swatch}" Background="{DynamicResource Brush.Canvas}" />
                        <TextBlock Text="画布 Canvas" Style="{StaticResource Set.Hint}" Margin="0,3,0,0" />
                        <TextBlock x:Name="HexCanvas" Style="{StaticResource Set.Mono}" FontSize="10.5"
                                   Foreground="{DynamicResource Brush.InkFaint}" Margin="0,0,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                        <Border Style="{StaticResource Set.Swatch}" Background="{DynamicResource Brush.Panel}" />
                        <TextBlock Text="面板 Panel" Style="{StaticResource Set.Hint}" Margin="0,3,0,0" />
                        <TextBlock x:Name="HexPanel" Style="{StaticResource Set.Mono}" FontSize="10.5"
                                   Foreground="{DynamicResource Brush.InkFaint}" Margin="0,0,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="2" Margin="0,0,10,0">
                        <Border Style="{StaticResource Set.Swatch}" Background="{DynamicResource Brush.Line}" />
                        <TextBlock Text="分隔线 Line" Style="{StaticResource Set.Hint}" Margin="0,3,0,0" />
                        <TextBlock x:Name="HexLine" Style="{StaticResource Set.Mono}" FontSize="10.5"
                                   Foreground="{DynamicResource Brush.InkFaint}" Margin="0,0,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="3" Margin="0,0,10,0">
                        <Border Style="{StaticResource Set.Swatch}" Background="{DynamicResource Brush.Ink}" />
                        <TextBlock Text="正文 Ink" Style="{StaticResource Set.Hint}" Margin="0,3,0,0" />
                        <TextBlock x:Name="HexInk" Style="{StaticResource Set.Mono}" FontSize="10.5"
                                   Foreground="{DynamicResource Brush.InkFaint}" Margin="0,0,0,0" />
                    </StackPanel>
                    <StackPanel Grid.Column="4">
                        <Border Style="{StaticResource Set.Swatch}" Background="{DynamicResource Brush.Signal}" />
                        <TextBlock Text="信号 Signal" Style="{StaticResource Set.Hint}" Margin="0,3,0,0" />
                        <TextBlock x:Name="HexSignal" Style="{StaticResource Set.Mono}" FontSize="10.5"
                                   Foreground="{DynamicResource Brush.InkFaint}" Margin="0,0,0,0" />
                    </StackPanel>
                </Grid>

                <Grid Margin="0,5,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Style="{StaticResource Btn.Primary}" Height="30" Padding="14,0,14,0" Content="开始生成"
                                IsHitTestVisible="False" Focusable="False" />
                        <Button Style="{StaticResource Btn.Secondary}" Height="30" Padding="14,0,14,0" Content="扫描预览"
                                Margin="8,0,0,0" IsHitTestVisible="False" Focusable="False" />
                        <TextBlock Text="实心突出主要操作，描边用于辅助操作" Style="{StaticResource Set.Hint}"
                                   Margin="12,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <CheckBox Grid.Column="1" Style="{StaticResource Set.Toggle}" IsChecked="True"
                              IsHitTestVisible="False" Focusable="False">
                        <TextBlock Text="已开启" Style="{StaticResource Set.Label}" />
                    </CheckBox>
                </Grid>

                <Grid Margin="0,5,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <controls:SegmentedProgress Height="4" Value="0.62" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="强调色标记选中与进度，绿、黄、红分别提示成功、注意和错误"
                               Style="{StaticResource Set.Hint}" Margin="12,0,0,0" VerticalAlignment="Center" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- ═══════════ 说明 ═══════════ -->
        <TextBlock Text="主题会立即切换。Windows 11 的标题栏随主题变化，Windows 10 的边框随系统变化。"
                   Style="{StaticResource Set.Hint}" Margin="0,6,0,0" />
    </StackPanel>

</settings:SettingsPageBase>
