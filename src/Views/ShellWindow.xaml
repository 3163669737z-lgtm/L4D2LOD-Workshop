<Window x:Class="LodStudio.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:LodStudio"
        xmlns:controls="clr-namespace:LodStudio.Controls"
        xmlns:svc="clr-namespace:LodStudio.Services"
        xmlns:vm="clr-namespace:LodStudio.ViewModels"
        Title="{x:Static local:AppInfo.TitleText}"
        Width="1320" Height="860" MinWidth="1120" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource Brush.Canvas}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="{StaticResource Font.Cjk}" FontSize="{StaticResource FS.Body}"
        Foreground="{DynamicResource Brush.Ink}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        AllowDrop="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="56" ResizeBorderThickness="6"
                            CornerRadius="0" GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <svc:BoolToVisibilityConverter x:Key="BoolToVis" />
        <svc:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />
        <svc:NotNullToVisibilityConverter x:Key="NotNullToVis" />

        <!-- 语义色调：用 Tag 传 "Ok"/"Warn"/"Err"/"Signal"/"Faint" -->
        <Style x:Key="ToneDot" TargetType="Ellipse">
            <Setter Property="Width" Value="5" />
            <Setter Property="Height" Value="5" />
            <Setter Property="Fill" Value="{DynamicResource Brush.InkFaint}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Ok">
                    <Setter Property="Fill" Value="{DynamicResource Brush.Ok}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Warn">
                    <Setter Property="Fill" Value="{DynamicResource Brush.Warn}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Err">
                    <Setter Property="Fill" Value="{DynamicResource Brush.Err}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Signal">
                    <Setter Property="Fill" Value="{DynamicResource Brush.Signal}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ToneText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FS.Micro}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.InkSoft}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Ok">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Ok}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Warn">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Warn}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Err">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Err}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Signal">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Signal}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 队列行 -->
        <DataTemplate x:Key="TaskRow" DataType="{x:Type vm:TaskItemVm}">
            <Grid Height="56" Margin="16,0,16,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="64" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="96" />
                    <ColumnDefinition Width="92" />
                    <ColumnDefinition Width="56" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding Index, StringFormat={}{0:00}}" Style="{StaticResource Text.Numeric}"
                           Foreground="{DynamicResource Brush.InkFaint}" HorizontalAlignment="Right" Margin="0,0,12,0"
                           VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <controls:Icon Kind="{Binding KindIcon}" Size="14" IconBrush="{DynamicResource Brush.InkSoft}" />
                    <TextBlock Text="{Binding KindText}" Style="{StaticResource Text.Micro}" Margin="6,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,10,0">
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="{StaticResource FS.Body}"
                               Foreground="{DynamicResource Brush.Ink}" />
                    <TextBlock Text="{Binding ParentPath}" TextTrimming="CharacterEllipsis" Style="{StaticResource Text.Mono}"
                               FontSize="{StaticResource FS.Micro}" Foreground="{DynamicResource Brush.InkFaint}" Margin="0,2,0,0" />
                </StackPanel>

                <TextBlock Grid.Column="3" Text="{Binding ScaleText}" Style="{StaticResource Text.Small}"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,8,0" />

                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Tag="{Binding StatusTone}" Style="{StaticResource ToneDot}" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding StatusText}" FontSize="{StaticResource FS.Small}" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.InkFaint}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StatusTone}" Value="Ok">
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Ok}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding StatusTone}" Value="Warn">
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Warn}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding StatusTone}" Value="Err">
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Err}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding StatusTone}" Value="Signal">
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Signal}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <StackPanel x:Name="Actions" Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center"
                            Opacity="0.28" HorizontalAlignment="Right">
                    <Button x:Name="BtnReveal" Style="{StaticResource Btn.Icon}" Width="24" Height="24" ToolTip="在资源管理器中显示"
                            Click="OnRevealTaskClick" Tag="{Binding}">
                        <controls:Icon Kind="ExternalLink" Size="13" IconBrush="{DynamicResource Brush.InkSoft}" />
                    </Button>
                    <Button x:Name="BtnRemove" Style="{StaticResource Btn.Icon}" Width="24" Height="24" ToolTip="从列表移除（不删文件）"
                            Click="OnRemoveTaskClick" Tag="{Binding}">
                        <controls:Icon Kind="Close" Size="13" IconBrush="{DynamicResource Brush.InkSoft}" />
                    </Button>
                </StackPanel>

                <!-- 选中行左侧信号条 -->
                <Border x:Name="SelBar" Grid.Column="0" Width="2" HorizontalAlignment="Left"
                        Background="Transparent" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="Actions" Property="Opacity" Value="1" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="SelBar" Property="Background" Value="{DynamicResource Brush.Signal}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- LOD 级别行（表格化：外框 + 列分隔 + 居中内容；数值输入即生效，不需要回车） -->
        <DataTemplate x:Key="LevelRow" DataType="{x:Type vm:LodLevelVm}">
            <Grid Height="40">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="34" />
                    <ColumnDefinition Width="82" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="82" />
                    <ColumnDefinition Width="28" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,0,1,0">
                    <TextBlock Text="{Binding NumberText}" Style="{StaticResource Text.Numeric}"
                               Foreground="{DynamicResource Brush.InkSoft}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <Border Grid.Column="1" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,0,1,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="Transparent" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMouseOver, ElementName=DistBox}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource Brush.RowHover}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=DistBox}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource Brush.Sunken}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBox x:Name="DistBox" Style="{StaticResource Input.Num}" BorderThickness="0" Background="Transparent"
                             Height="26" Text="{Binding DistanceText, UpdateSourceTrigger=PropertyChanged}"
                             Tag="{Binding}" ToolTip="切换距离（HU，1 HU ≈ 1.9 厘米）；输入即生效"
                             GotKeyboardFocus="OnLevelNumberGotFocus"
                             LostKeyboardFocus="OnLevelNumberLostFocus"
                             PreviewKeyDown="OnLevelNumberKeyDown" />
                </Border>

                <Border Grid.Column="2" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,0,1,0">
                    <controls:RatioBar Margin="10,0" VerticalAlignment="Center" HorizontalAlignment="Stretch"
                                       Ratio="{Binding Ratio, Mode=TwoWay}" Maximum="{Binding MaxRatio}" Tag="{Binding}" />
                </Border>

                <Border Grid.Column="3" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,0,1,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="Transparent" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMouseOver, ElementName=RatioBox}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource Brush.RowHover}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=RatioBox}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource Brush.Sunken}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBox x:Name="RatioBox" Style="{StaticResource Input.Num}" BorderThickness="0" Background="Transparent"
                             Height="26" Text="{Binding RatioText, UpdateSourceTrigger=PropertyChanged}"
                             Tag="{Binding}" ToolTip="保留面数百分比（0.1–100）；输入即生效"
                             GotKeyboardFocus="OnLevelNumberGotFocus"
                             LostKeyboardFocus="OnLevelNumberLostFocus"
                             PreviewKeyDown="OnLevelNumberKeyDown" />
                </Border>

                <Button Grid.Column="4" Style="{StaticResource Btn.Icon}" Width="24" Height="24"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        ToolTip="删除这一级" Click="OnRemoveLevelClick" Tag="{Binding}">
                    <controls:Icon Kind="Close" Size="12" IconBrush="{DynamicResource Brush.InkFaint}" />
                </Button>

                <Border Grid.ColumnSpan="5" Height="1" VerticalAlignment="Bottom" Background="{DynamicResource Brush.Line}" />
            </Grid>
        </DataTemplate>

        <!-- 计划行 -->
        <DataTemplate x:Key="PlanRow" DataType="{x:Type vm:PlanQcRowVm}">
            <Border Height="44" ToolTip="{Binding Tooltip}" Background="Transparent">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="52" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="112" />
                        <ColumnDefinition Width="88" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding ActionText}" FontSize="{StaticResource FS.Small}"
                               VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.InkFaint}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ActionTone}" Value="Ok">
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Ok}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding ActionTone}" Value="Err">
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Err}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock Text="{Binding QcName}" TextTrimming="CharacterEllipsis" FontSize="{StaticResource FS.Small}" />
                        <TextBlock Text="{Binding Reason}" TextTrimming="CharacterEllipsis" Style="{StaticResource Text.Micro}"
                                   Foreground="{DynamicResource Brush.InkFaint}" Margin="0,1,0,0" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding ModelsText}" Style="{StaticResource Text.Micro}"
                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Grid.Column="3" Text="{Binding JobCount, StringFormat={}{0} 任务}" Style="{StaticResource Text.Micro}"
                               VerticalAlignment="Center" HorizontalAlignment="Right" />
                </Grid>
            </Border>
        </DataTemplate>

        <!-- 日志行 -->
        <DataTemplate x:Key="LogRow" DataType="{x:Type vm:LogLineVm}">
            <Grid Height="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="52" />
                    <ColumnDefinition Width="30" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding TimeText}" Style="{StaticResource Text.Mono}" FontSize="10.5"
                           Foreground="{DynamicResource Brush.InkFaint}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding LevelText}" FontSize="10.5"
                           VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.InkFaint}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Tone}" Value="Err">
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Err}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Tone}" Value="Warn">
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Warn}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Tone}" Value="Stage">
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Signal}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Grid.Column="2" Text="{Binding Text}"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Mono}">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.InkSoft}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsStage}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Tone}" Value="Err">
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Err}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Border x:Name="RootBorder" BorderBrush="{DynamicResource Brush.WindowBorder}" BorderThickness="1"
                Background="{DynamicResource Brush.Canvas}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="56" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="68" />
                </Grid.RowDefinitions>

                <!-- ═══════════════════ 顶栏 ═══════════════════ -->
                <Grid Grid.Row="0" x:Name="CaptionBar">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,16,0">
                        <Viewbox Width="26" Height="26" VerticalAlignment="Center">
                            <Canvas Width="24" Height="24">
                                <!-- 品牌标记：递降阶梯 + 顶部测线 + 远点 -->
                                <Path Fill="{DynamicResource Brush.Ink}"
                                      Data="M2.8,5.4 H6.8 V19.8 H2.8 Z M6.8,8.8 H10.8 V19.8 H6.8 Z M10.8,12.2 H14.8 V19.8 H10.8 Z M14.8,15.6 H18.8 V19.8 H14.8 Z" />
                                <Rectangle Fill="{DynamicResource Brush.Ink}" Canvas.Left="2.2" Canvas.Top="21.2" Width="19.6" Height="0.9" />
                                <Path Stroke="{DynamicResource Brush.Signal}" StrokeThickness="1.4" Data="M2.4,3.4 L21.4,3.4" />
                                <Ellipse Fill="{DynamicResource Brush.Signal}" Width="2.6" Height="2.6" Canvas.Left="20.1" Canvas.Top="2.1" />
                            </Canvas>
                        </Viewbox>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                            <TextBlock Text="{x:Static local:AppInfo.ProductName}" FontSize="{StaticResource FS.Brand}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.Ink}" VerticalAlignment="Center" />
                            <Border Background="{DynamicResource Brush.Sunken}" Padding="6,1,6,2" Margin="10,1,0,0" VerticalAlignment="Center">
                                <TextBlock Text="v7.0" FontFamily="{StaticResource Font.Latin}" FontSize="{StaticResource FS.Micro}"
                                           Foreground="{DynamicResource Brush.InkSoft}" />
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                        <Button x:Name="BtnEnv" Click="OnEnvClick" ToolTip="{Binding EnvTip}" Margin="0,0,10,0"
                                Background="Transparent" BorderThickness="0" Padding="6,0,8,0" Height="24" Cursor="Hand"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Tag="{Binding EnvTone}" Style="{StaticResource ToneDot}" />
                                <TextBlock Text="{Binding EnvText}" Style="{StaticResource Text.Micro}" Margin="6,0,3,0"
                                           VerticalAlignment="Center" />
                                <controls:Icon Kind="ChevronRight" Size="9" IconBrush="{DynamicResource Brush.InkFaint}"
                                               VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnTheme" Style="{StaticResource CaptionButton}" Click="OnThemeClick" ToolTip="切换浅色 / 暗色" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <controls:Icon Kind="Moon" Size="14" IconBrush="{DynamicResource Brush.InkSoft}" />
                        </Button>
                        <Button x:Name="BtnMenu" Style="{StaticResource CaptionButton}" Click="OnMenuClick" ToolTip="菜单" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <controls:Icon Kind="Menu" Size="14" IconBrush="{DynamicResource Brush.InkSoft}" />
                        </Button>

                        <Border Width="1" Background="{DynamicResource Brush.Line}" Margin="6,17,6,17" />

                        <Button x:Name="BtnMin" Style="{StaticResource WindowButton}" Click="OnMinClick" ToolTip="最小化"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <controls:Icon Kind="Minimize" Size="12" IconBrush="{DynamicResource Brush.InkSoft}" />
                        </Button>
                        <Button x:Name="BtnMax" Style="{StaticResource WindowButton}" Click="OnMaxClick" ToolTip="最大化"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <controls:Icon Kind="Maximize" Size="11" IconBrush="{DynamicResource Brush.InkSoft}" />
                        </Button>
                        <Button x:Name="BtnClose" Style="{StaticResource WindowButtonClose}" Click="OnCloseClick" ToolTip="关闭"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <controls:Icon Kind="Close" Size="11" IconBrush="{DynamicResource Brush.InkSoft}" />
                        </Button>
                    </StackPanel>

                    <!-- 顶栏底部刻度规（量具语言，全程序只出现于此与阶梯图） -->
                    <controls:TickStrip Grid.ColumnSpan="4" Height="7" VerticalAlignment="Bottom" Margin="0,0,0,1"
                                        Step="8" TickLength="2.5" LongEvery="5" LongLength="5" />
                    <Border Grid.ColumnSpan="4" Height="1" VerticalAlignment="Bottom" Background="{DynamicResource Brush.Line}" />
                </Grid>

                <!-- ═══════════════════ 主体 ═══════════════════ -->
                <Grid Grid.Row="1" Margin="20,10,20,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="400" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- ───── 作业队列 ───── -->
                        <Border Grid.Row="0" Background="{DynamicResource Brush.Panel}"
                                BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1">
                            <Grid>
                                <controls:CornerBrackets IsHitTestVisible="False" Margin="0" BracketLength="10" />
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="40" />
                                        <RowDefinition Height="44" />
                                        <RowDefinition Height="1" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="28" />
                                    </Grid.RowDefinitions>

                                    <!-- 面板头 -->
                                    <Grid Grid.Row="0" Margin="16,0,16,0">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <TextBlock Text="作业队列" Style="{StaticResource Text.PageTitle}" VerticalAlignment="Center" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding Queue.SummaryText}" Style="{StaticResource Text.Small}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                                    </Grid>
                                    <Border Grid.Row="0" Height="1" VerticalAlignment="Bottom" Background="{DynamicResource Brush.Line}" />

                                    <!-- 工具行：筛选页签 | （导入入口见空状态 / 右键菜单 / ☰ 菜单） | 搜索（靠右） -->
                                    <Grid Grid.Row="1" Margin="16,0,16,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <controls:Segmented x:Name="SegFilter" Grid.Column="0" VerticalAlignment="Center"
                                                            Variant="Tabs" FontSize="11" ItemPadding="9" />
                                        <Border x:Name="SearchBox" Grid.Column="2" Width="204" Height="30" VerticalAlignment="Center"
                                                Background="{DynamicResource Brush.Sunken}" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1">
                                            <Grid>
                                                <controls:Icon Kind="Search" Size="13" HorizontalAlignment="Left" Margin="9,0,0,0"
                                                               IconBrush="{DynamicResource Brush.InkFaint}" VerticalAlignment="Center" />
                                                <TextBox x:Name="TxtSearch" Style="{StaticResource Input.Text}" BorderThickness="0" Height="Auto"
                                                         Background="Transparent" Margin="26,0,24,0" VerticalContentAlignment="Center"
                                                         Text="{Binding Queue.SearchText, UpdateSourceTrigger=PropertyChanged}"
                                                         Tag="搜索任务" />
                                                <Button x:Name="BtnClearSearch" Width="20" Height="20"
                                                        HorizontalAlignment="Right" Margin="0,0,4,0" ToolTip="清空搜索"
                                                        Click="OnClearSearchClick">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource Btn.Icon}">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Text, ElementName=TxtSearch}" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                    <controls:Icon Kind="Close" Size="11" IconBrush="{DynamicResource Brush.InkFaint}" />
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </Grid>

                                    <!-- 表头：已按反馈删除列标题文字，只保留一条分隔线 -->
                                    <Border Grid.Row="2" Height="1" Background="{DynamicResource Brush.Line}" RenderOptions.EdgeMode="Aliased" />


                                    <!-- 列表 -->
                                    <ListBox x:Name="QueueList" Grid.Row="3" Style="{StaticResource List.Base}"
                                             ItemTemplate="{StaticResource TaskRow}" ItemContainerStyle="{StaticResource List.Row}"
                                             ItemsSource="{Binding Queue.View}" SelectionMode="Extended"
                                             SelectionChanged="OnQueueSelectionChanged"
                                             PreviewMouseLeftButtonDown="OnQueueListPreviewMouseLeftButtonDown"
                                             MouseDoubleClick="OnQueueDoubleClick"
                                             PreviewMouseRightButtonDown="OnQueueRightButtonDown"
                                             KeyDown="OnQueueKeyDown"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto" />

                                    <!-- 空状态 -->
                                    <Border x:Name="EmptyState" Grid.Row="3" Background="{DynamicResource Brush.Panel}"
                                            Visibility="{Binding Queue.IsEmpty, Converter={StaticResource BoolToVis}}">
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,16">
                                            <controls:TickStrip Width="150" Height="9" HorizontalAlignment="Center" Step="6" TickLength="2" LongEvery="4" LongLength="4" />
                                            <TextBlock Text="队列为空" Style="{StaticResource Text.PageTitle}" HorizontalAlignment="Center" Margin="0,14,0,0" />
                                            <TextBlock Text="把工程文件夹、QC 或模型文件拖进窗口；也可以从下面两个入口导入。" Style="{StaticResource Text.Small}"
                                                       HorizontalAlignment="Center" Margin="0,12,0,0" />
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0">
                                                <Button Style="{StaticResource Btn.Secondary}" Height="34"
                                                        AutomationProperties.Name="导入文件夹" Click="OnImportFolderClick">
                                                    <StackPanel Orientation="Horizontal">
                                                        <controls:Icon Kind="Folder" Size="14" IconBrush="{DynamicResource Brush.InkSoft}" />
                                                        <TextBlock Text="导入文件夹" Margin="8,0,0,0" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource Btn.Secondary}" Height="34" Margin="8,0,0,0"
                                                        AutomationProperties.Name="导入文件" Click="OnImportFilesClick">
                                                    <StackPanel Orientation="Horizontal">
                                                        <controls:Icon Kind="File" Size="14" IconBrush="{DynamicResource Brush.InkSoft}" />
                                                        <TextBlock Text="导入文件" Margin="8,0,0,0" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- 无匹配 -->
                                    <Border x:Name="NoMatchState" Grid.Row="3" Background="{DynamicResource Brush.Panel}"
                                            Visibility="{Binding Queue.IsNoMatch, Converter={StaticResource BoolToVis}}">
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,16">
                                            <TextBlock Text="没有匹配的任务" Style="{StaticResource Text.PageTitle}" HorizontalAlignment="Center" />
                                            <TextBlock Text="换个关键词，或清掉筛选条件。" Style="{StaticResource Text.Small}"
                                                       HorizontalAlignment="Center" Margin="0,10,0,0" />
                                            <Button Style="{StaticResource Btn.Ghost}" Height="32" Margin="0,14,0,0"
                                                    HorizontalAlignment="Center" Click="OnResetFilterClick">
                                                <TextBlock Text="清除筛选与搜索" />
                                            </Button>
                                        </StackPanel>
                                    </Border>

                                    <!-- 计划视图（覆盖列表区） -->
                                    <Border x:Name="PlanOverlay" Grid.Row="1" Grid.RowSpan="4" Panel.ZIndex="5"
                            Background="{DynamicResource Brush.Panel}"
                                            Visibility="{Binding IsPlanVisible, Converter={StaticResource BoolToVis}}">
                                        <Grid Margin="16,8,16,10">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid Grid.Row="0">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock Text="作业计划" Style="{StaticResource Text.PageTitle}" />
                                                </StackPanel>
                                                <Button Style="{StaticResource Btn.Bare}" HorizontalAlignment="Right" Click="OnClosePlanClick">
                                                    <TextBlock Text="返回队列" />
                                                </Button>
                                            </Grid>
                                            <StackPanel Grid.Row="1" Margin="0,6,0,8">
                                                <TextBlock Text="{Binding PlanPreview.Headline}" Style="{StaticResource Text.Small}"
                                                           Foreground="{DynamicResource Brush.Ink}" />
                                                <TextBlock Text="{Binding PlanPreview.Subline}" Style="{StaticResource Text.Micro}" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <ListBox Grid.Row="2" Style="{StaticResource List.Base}" ItemsSource="{Binding PlanPreview.Rows}"
                                                     ItemTemplate="{StaticResource PlanRow}" ItemContainerStyle="{StaticResource List.Row}"
                                                     ScrollViewer.VerticalScrollBarVisibility="Auto" />
                                            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                                                <Button Style="{StaticResource Btn.Ghost}" Height="32" Click="OnClosePlanClick">
                                                    <TextBlock Text="返回队列" />
                                                </Button>
                                                <Button Style="{StaticResource Btn.Primary}" Height="34" Margin="8,0,0,0" Click="OnStartFromPlanClick"
                                                        IsEnabled="{Binding PlanPreview.CanStartFromPlan}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <controls:Icon Kind="Play" Size="13" IconBrush="{DynamicResource Brush.SignalInk}" />
                                                        <TextBlock Text="按此计划开始生成" Margin="8,0,0,0" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <!-- 页脚 -->
                                    <Grid Grid.Row="4" Margin="16,0,16,0"
                                          Visibility="{Binding Queue.HasItems, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding LastRunText}" Style="{StaticResource Text.Micro}" VerticalAlignment="Center" />
                                        <Button Style="{StaticResource Btn.Bare}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                                Click="OnOpenReportClick" IsEnabled="{Binding CanOpenLastReport}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="查看报告" FontSize="{StaticResource FS.Micro}" />
                                                <controls:Icon Kind="ChevronRight" Size="10" IconBrush="{DynamicResource Brush.InkFaint}" Margin="4,0,0,0" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                    <Border Grid.Row="4" Height="1" VerticalAlignment="Top" Background="{DynamicResource Brush.Line}" />
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- ───── 运行日志 ───── -->
                        <Border x:Name="LogCard" Grid.Row="2" Height="44" Background="{DynamicResource Brush.Panel}"
                                BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" ClipToBounds="True">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="42" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="16,0,10,0">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="运行日志" Style="{StaticResource Text.Section}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <controls:Segmented x:Name="SegLogFilter" Variant="Tabs" FontSize="11" ItemPadding="8" />
                                        <Border Width="1" Height="14" Background="{DynamicResource Brush.Line}" Margin="10,0,8,0" />
                                        <Button Style="{StaticResource Btn.Bare}" AutomationProperties.Name="复制日志" Click="OnCopyLogClick"
                                                IsEnabled="{Binding Log.HasLines}" ToolTip="复制当前显示的日志">
                                            <TextBlock Text="复制" FontSize="{StaticResource FS.Micro}" />
                                        </Button>
                                        <Button Style="{StaticResource Btn.Bare}" AutomationProperties.Name="清空日志" Click="OnClearLogClick"
                                                IsEnabled="{Binding Log.HasLines}" ToolTip="清空日志">
                                            <TextBlock Text="清空" FontSize="{StaticResource FS.Micro}" />
                                        </Button>
                                        <Button x:Name="BtnToggleLog" Style="{StaticResource Btn.Icon}" Width="24" Height="24" Margin="4,0,0,0"
                                                Click="OnToggleLogClick" ToolTip="展开 / 折叠（Ctrl+L）">
                                            <controls:Icon Kind="ChevronDown" Size="12" IconBrush="{DynamicResource Brush.InkSoft}" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                                <Border Grid.Row="0" Height="1" VerticalAlignment="Bottom" Background="{DynamicResource Brush.Line}" />

                                <Grid x:Name="LogBody" Grid.Row="1" Visibility="Collapsed">
                                    <ListBox x:Name="LogList" Style="{StaticResource List.Base}" ItemsSource="{Binding Log.View}"
                                             ItemTemplate="{StaticResource LogRow}" ItemContainerStyle="{StaticResource List.Row}"
                                             Padding="16,4,10,6" ScrollViewer.VerticalScrollBarVisibility="Auto" />
                                    <TextBlock Text="还没有日志" Style="{StaticResource Text.Micro}" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" IsHitTestVisible="False"
                                               Visibility="{Binding Log.IsEmpty, Converter={StaticResource BoolToVis}}" />
                                    <Button x:Name="BtnNewLogs" Style="{StaticResource Btn.Primary}" Height="26" Padding="10,0,10,0"
                                            HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,18,8"
                                            Visibility="{Binding Log.HasNew, Converter={StaticResource BoolToVis}}"
                                            Click="OnResumeFollowClick">
                                        <TextBlock Text="{Binding Log.NewCount, StringFormat={}{0} 条新日志}" FontSize="{StaticResource FS.Micro}" />
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ───── LOD 方案 ───── -->
                    <Border Grid.Column="2" Background="{DynamicResource Brush.Panel}"
                            BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1">
                        <Grid Margin="16,0,16,6">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="40" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="LOD 方案" Style="{StaticResource Text.PageTitle}" VerticalAlignment="Center" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <ComboBox x:Name="CmbPreset" Style="{StaticResource Combo.Base}" Width="172"
                                              SelectionChanged="OnPresetSelectionChanged"
                                              ToolTip="内置预设 + 我的预设" />
                                    <Button Style="{StaticResource Btn.Bare}" Margin="4,0,0,0" Click="OnRestorePresetClick"
                                            IsEnabled="{Binding LodPlan.ShowRestore}" ToolTip="回到预设原始参数">
                                        <TextBlock Text="恢复" FontSize="{StaticResource FS.Micro}" />
                                    </Button>
                                </StackPanel>
                            </Grid>
                            <Border Grid.Row="0" Height="1" VerticalAlignment="Bottom" Background="{DynamicResource Brush.Line}" />

                            <!-- 级别表格：行高 = (可用高度 - 表头) / 8；8 级刚好铺满，少量级别正常留空 -->
                            <Grid Grid.Row="1" x:Name="LodTableHost">
                                <StackPanel VerticalAlignment="Top">
                            <Border x:Name="LodTopFrame" Height="1" Margin="0,6,0,0" Background="{DynamicResource Brush.LineStrong}"
                                    RenderOptions.EdgeMode="Aliased" />
                            <Border Background="{DynamicResource Brush.Panel}"
                                    BorderBrush="{DynamicResource Brush.LineStrong}" BorderThickness="1,0,1,0"
                                    RenderOptions.EdgeMode="Aliased">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="26" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0" Background="{DynamicResource Brush.Sunken}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="34" />
                                            <ColumnDefinition Width="82" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="82" />
                                            <ColumnDefinition Width="28" />
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,0,1,0">
                                            <TextBlock Text="级别" Style="{StaticResource Text.Micro}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <Border Grid.Column="1" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,0,1,0">
                                            <TextBlock Text="距离 HU" Style="{StaticResource Text.Micro}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <Border Grid.Column="2" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,0,1,0">
                                            <TextBlock Text="保留比例" Style="{StaticResource Text.Micro}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <Border Grid.Column="3" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,0,1,0">
                                            <TextBlock Text="比例 %" Style="{StaticResource Text.Micro}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <Border Grid.Column="4" />
                                        <Border Grid.ColumnSpan="5" Height="1" VerticalAlignment="Bottom" Background="{DynamicResource Brush.Line}" />
                                    </Grid>

                                    <ItemsControl x:Name="LevelList" Grid.Row="1" ItemsSource="{Binding LodPlan.Levels}"
                                                  ItemTemplate="{StaticResource LevelRow}" />
                                </Grid>
                            </Border>
                            <Border x:Name="LodTableBottom" Height="1" Background="{DynamicResource Brush.LineStrong}"
                                    RenderOptions.EdgeMode="Aliased" />

                            <!-- 添加一级：整宽大框按钮（表格下方；8 级时隐藏） -->
                            <Button Style="{StaticResource Btn.Secondary}" Height="32" Margin="0,4,0,0" AutomationProperties.Name="添加一级"
                                    HorizontalAlignment="Stretch" Click="OnAddLevelClick" ToolTip="在末尾添加一级"
                                    Visibility="{Binding LodPlan.CanAddLevel, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <controls:Icon Kind="Plus" Size="12" IconBrush="{DynamicResource Brush.InkSoft}" />
                                    <TextBlock Text="添加一级" FontSize="{StaticResource FS.Small}" Margin="6,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                                </StackPanel>
                                <!-- 8 级铺满时：表格底框线画在 host 最底部，保证不会被最后一行覆盖 -->
                                <Border x:Name="LodBottomFrame" Height="1" VerticalAlignment="Bottom"
                                        Background="{DynamicResource Brush.LineStrong}" RenderOptions.EdgeMode="Aliased"
                                        Visibility="{Binding LodPlan.CanAddLevel, Converter={StaticResource InverseBoolToVis}}" />
                            </Grid>

                            <!-- 写入方式（与上方控件之间加横向分隔条） -->
                            <StackPanel Grid.Row="3" Margin="0,12,0,0">
                                <Border x:Name="WriteSeparator" Height="1" Background="{DynamicResource Brush.Line}" />
                                <TextBlock Text="写入方式" Style="{StaticResource Text.Micro}" Margin="0,10,0,6" />
                                <controls:Segmented x:Name="SegWriteMode" Variant="Boxed" EqualWidths="True"
                                                    HorizontalAlignment="Stretch" FontSize="11.5" ItemPadding="10" Height="30"
                                                    ToolTip="{Binding LodPlan.WriteModeHint}" />
                            </StackPanel>

                            <!-- 高级参数：带外框、文字居中 -->
                            <StackPanel Grid.Row="4" Margin="0,12,0,0">
                                <Border Height="1" Background="{DynamicResource Brush.Line}" />
                                <Button Style="{StaticResource Btn.Secondary}" Height="38" Margin="0,10,0,0" AutomationProperties.Name="高级参数" Click="OnAdvancedClick"
                                        HorizontalContentAlignment="Stretch"
                                        ToolTip="质量优先 / 覆盖手写 / 试编译 / 跳过主模型 / 并行数（在设置的第 3 页）">
                                    <Grid HorizontalAlignment="Stretch">
                                        <TextBlock Text="高级参数" Style="{StaticResource Text.Small}" HorizontalAlignment="Center"
                                                   VerticalAlignment="Center" Foreground="{DynamicResource Brush.Ink}" />
                                        <controls:Icon Kind="ChevronRight" Size="11" IconBrush="{DynamicResource Brush.InkFaint}"
                                                       HorizontalAlignment="Right" Margin="0,0,12,0" VerticalAlignment="Center" />
                                    </Grid>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ═══════════════════ HUD ═══════════════════ -->
                <Border Grid.Row="2" Margin="20,0,20,12" Background="{DynamicResource Brush.Panel}"
                        BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="3" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <controls:SegmentedProgress x:Name="Progress" Grid.Row="0" Height="3"
                                                    Value="{Binding ProgressValue}" IsIndeterminate="{Binding ProgressIndeterminate}"
                                                    Failed="{Binding ProgressFailed}" Visibility="{Binding ProgressVisible, Converter={StaticResource BoolToVis}}" />
                        <Grid Grid.Row="1" Margin="16,0,12,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse Tag="{Binding StatusTone}" Style="{StaticResource ToneDot}" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding StatusTitle}" FontSize="{StaticResource FS.Section}" FontWeight="SemiBold"
                                               VerticalAlignment="Center" Foreground="{DynamicResource Brush.Ink}" />
                                </StackPanel>
                                <TextBlock Text="{Binding StatusSub}" Style="{StaticResource Text.Micro}" Margin="13,3,0,0"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,20,0">
                                <TextBlock Text="{Binding ReadoutMainText}" FontFamily="{StaticResource Font.Latin}"
                                           FontSize="{StaticResource FS.Readout}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Brush.Ink}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ReadoutSub}" Style="{StaticResource Text.Micro}" Margin="6,10,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="BtnPreview" Style="{StaticResource Btn.Secondary}" Height="34"
                                        Visibility="{Binding ShowStartButton, Converter={StaticResource BoolToVis}}"
                                        IsEnabled="{Binding CanPreview}" Click="OnPreviewClick" ToolTip="只读：列出会做什么、哪些跳过">
                                    <StackPanel Orientation="Horizontal">
                                        <controls:Icon Kind="Scan" Size="13" IconBrush="{DynamicResource Brush.InkSoft}" />
                                        <TextBlock Text="扫描预览" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnStart" Style="{StaticResource Btn.Primary}" Height="34" Margin="8,0,0,0"
                                        Visibility="{Binding ShowStartButton, Converter={StaticResource BoolToVis}}"
                                        IsEnabled="{Binding CanStart}" Click="OnStartClick"
                                        ToolTip="{Binding StartHint}" ToolTipService.ShowOnDisabled="True">
                                    <StackPanel Orientation="Horizontal">
                                        <controls:Icon Kind="Play" Size="12" IconBrush="{DynamicResource Brush.SignalInk}" />
                                        <TextBlock Text="开始生成" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnStop" Style="{StaticResource Btn.Danger}" Height="34"
                                        Visibility="{Binding ShowStopButton, Converter={StaticResource BoolToVis}}"
                                        Click="OnStopClick" ToolTip="停止（Esc）">
                                    <StackPanel Orientation="Horizontal">
                                        <controls:Icon Kind="Stop" Size="11" IconBrush="{DynamicResource Brush.Panel}" />
                                        <TextBlock Text="停止" Margin="8,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnOpenReport" Style="{StaticResource Btn.Secondary}" Height="34" Margin="8,0,0,0"
                                        Visibility="{Binding HasLastRun, Converter={StaticResource BoolToVis}}"
                                        IsEnabled="{Binding CanOpenLastReport}" Click="OnOpenReportClick" ToolTip="打开上次的运行报告">
                                    <StackPanel Orientation="Horizontal">
                                        <controls:Icon Kind="Report" Size="13" IconBrush="{DynamicResource Brush.InkSoft}" />
                                        <TextBlock Text="报告" Margin="7,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnOpenFolder" Style="{StaticResource Btn.Secondary}" Height="34" Margin="8,0,0,0"
                                        Visibility="{Binding HasLastRun, Converter={StaticResource BoolToVis}}"
                                        Click="OnOpenFolderClick" ToolTip="打开输出目录">
                                    <StackPanel Orientation="Horizontal">
                                        <controls:Icon Kind="Folder" Size="13" IconBrush="{DynamicResource Brush.InkSoft}" />
                                        <TextBlock Text="目录" Margin="7,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- 菜单打开时的透明点击捕获层：点窗口任意处（包括再点一次 ☰）都关闭菜单 -->
        <Border x:Name="MenuCatcher" Background="Transparent" Visibility="Collapsed" Panel.ZIndex="50"
                MouseLeftButtonDown="OnMenuCatcherClick" />

        <!-- ═══════════════════ 覆盖层：拖放高亮 / 对话框 / Toast ═══════════════════ -->
        <Border x:Name="DropOverlay" Background="#55000000" Visibility="Collapsed" IsHitTestVisible="False">
            <Border Margin="40" Background="{DynamicResource Brush.Panel}" BorderBrush="{DynamicResource Brush.Signal}"
                    BorderThickness="2" Opacity="0.98">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <controls:Icon Kind="Folder" Size="44" IconBrush="{DynamicResource Brush.Signal}" HorizontalAlignment="Center" />
                    <TextBlock Text="松开加入任务" Style="{StaticResource Text.PageTitle}" HorizontalAlignment="Center" Margin="0,14,0,0" />
                    <TextBlock x:Name="DropHint" Text="支持工程文件夹 / QC / GLB / SMD" Style="{StaticResource Text.Small}"
                               HorizontalAlignment="Center" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
        </Border>

        <controls:ToastHost x:Name="Toasts" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,92"
                            Width="360" Height="200" />

        <controls:DialogHost x:Name="Dialogs" />
    </Grid>
</Window>
