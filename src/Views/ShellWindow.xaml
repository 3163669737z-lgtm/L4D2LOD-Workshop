<Window x:Class="LodStudio.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:LodStudio"
        xmlns:controls="clr-namespace:LodStudio.Controls"
        xmlns:svc="clr-namespace:LodStudio.Services"
        xmlns:vm="clr-namespace:LodStudio.ViewModels"
        Title="{x:Static local:AppInfo.TitleText}"
        Width="1320" Height="860" MinWidth="1120" MinHeight="720"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ResizeMode="CanResize"
        Background="{DynamicResource Brush.Canvas}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="{StaticResource Font.Cjk}" FontSize="{StaticResource FS.Body}"
        Foreground="{DynamicResource Brush.Ink}"
        TextOptions.TextFormattingMode="Ideal"
        TextOptions.TextRenderingMode="ClearType"
        AllowDrop="True">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="56" ResizeBorderThickness="6"
                            CornerRadius="0" GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <svc:BoolToVisibilityConverter x:Key="BoolToVis" />
        <svc:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />

        <!-- 语义色调：用 Tag 传 "Ok"/"Warn"/"Err"/"Signal"/"Faint" -->
        <Style x:Key="ToneDot" TargetType="Ellipse">
            <Setter Property="Width" Value="5" />
            <Setter Property="Height" Value="5" />
            <Setter Property="Fill" Value="{DynamicResource Brush.InkFaint}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Ok">
                    <Setter Property="Fill" Value="{DynamicResource Brush.Ok}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Warn">
                    <Setter Property="Fill" Value="{DynamicResource Brush.Warn}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Err">
                    <Setter Property="Fill" Value="{DynamicResource Brush.Err}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Signal">
                    <Setter Property="Fill" Value="{DynamicResource Brush.Signal}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ToneText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="{StaticResource FS.Micro}" />
            <Setter Property="Foreground" Value="{DynamicResource Brush.InkSoft}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Ok">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Ok}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Warn">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Warn}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Err">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Err}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Signal">
                    <Setter Property="Foreground" Value="{DynamicResource Brush.Signal}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WrappedToolTip" TargetType="ToolTip">
            <Setter Property="MaxWidth" Value="500" />
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" Style="{StaticResource Text.Body}" />
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 队列行 -->
        <DataTemplate x:Key="TaskRow" DataType="{x:Type vm:TaskItemVm}">
            <Grid Height="56" Margin="12,0,12,0" Background="Transparent" ToolTipService.ShowDuration="12000">
                <Grid.ToolTip>
                    <ToolTip Style="{StaticResource WrappedToolTip}" Content="{Binding Tooltip}" />
                </Grid.ToolTip>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30" />
                    <ColumnDefinition Width="55" />
                    <ColumnDefinition Width="3*" />
                    <ColumnDefinition Width="*" MinWidth="62" MaxWidth="170" />
                    <ColumnDefinition Width="73" />
                    <ColumnDefinition Width="52" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding Index, StringFormat={}{0:00}}" Style="{StaticResource Text.Numeric}"
                           Foreground="{DynamicResource Brush.InkFaint}" HorizontalAlignment="Right" Margin="0,0,12,0"
                           VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <controls:Icon Kind="{Binding KindIcon}" Size="14" IconBrush="{DynamicResource Brush.InkSoft}" />
                    <TextBlock Text="{Binding KindText}" Style="{StaticResource Text.Micro}" Margin="6,0,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="0,0,12,0">
                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" FontSize="{StaticResource FS.Body}"
                               Foreground="{DynamicResource Brush.Ink}" />
                    <TextBlock Text="{Binding DisplayPath}" TextTrimming="CharacterEllipsis" Style="{StaticResource Text.Small}" Margin="0,2,0,0" />
                </StackPanel>

                <TextBlock Grid.Column="3" Text="{Binding RowDetail}" Style="{StaticResource Text.Small}"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,8,0" />

                <StackPanel Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Tag="{Binding StatusTone}" Style="{StaticResource ToneDot}" Margin="0,0,6,0" />
                    <TextBlock Text="{Binding StatusText}" FontSize="{StaticResource FS.Small}" VerticalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource Brush.InkSoft}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StatusTone}" Value="Ok">
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Ok}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding StatusTone}" Value="Warn">
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Warn}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding StatusTone}" Value="Err">
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Err}" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding StatusTone}" Value="Signal">
                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Signal}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <StackPanel x:Name="Actions" Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center"
                            Opacity="0.76" HorizontalAlignment="Right">
                    <Button x:Name="BtnReveal" Style="{StaticResource Btn.Icon}" Width="24" Height="24" ToolTip="在资源管理器中显示"
                            Click="OnRevealTaskClick" Tag="{Binding}" AutomationProperties.Name="在资源管理器中显示">
                        <controls:Icon Kind="ExternalLink" Size="13" IconBrush="{DynamicResource Brush.InkSoft}" />
                    </Button>
                    <Button x:Name="BtnRemove" Style="{StaticResource Btn.Icon}" Width="24" Height="24" ToolTip="从队列移除"
                            Click="OnRemoveTaskClick" Tag="{Binding}" AutomationProperties.Name="从队列移除"
                            IsEnabled="{Binding DataContext.CanEdit, RelativeSource={RelativeSource AncestorType=Window}}">
                        <controls:Icon Kind="Close" Size="13" IconBrush="{DynamicResource Brush.InkSoft}" />
                    </Button>
                </StackPanel>

                <!-- 选中行左侧信号条 -->
                <Border x:Name="SelBar" Grid.Column="0" Width="2" HorizontalAlignment="Left"
                        IsHitTestVisible="False" Background="Transparent" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="Actions" Property="Opacity" Value="1" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="SelBar" Property="Background" Value="{DynamicResource Brush.Signal}" />
                </DataTrigger>
                <Trigger SourceName="Actions" Property="IsKeyboardFocusWithin" Value="True">
                    <Setter TargetName="Actions" Property="Opacity" Value="1" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- LOD 级别行（表格化：外框 + 列分隔 + 居中内容；数值输入即生效，不需要回车） -->
        <DataTemplate x:Key="LevelRow" DataType="{x:Type vm:LodLevelVm}">
            <Grid Height="40">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="34" />
                    <ColumnDefinition Width="82" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="82" />
                    <ColumnDefinition Width="28" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,0,1,0">
                    <TextBlock Text="{Binding NumberText}" Style="{StaticResource Text.Numeric}"
                               Foreground="{DynamicResource Brush.InkSoft}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <Border Grid.Column="1" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,0,1,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="Transparent" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMouseOver, ElementName=DistBox}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource Brush.RowHover}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=DistBox}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource Brush.Sunken}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.FocusRing}" />
                                    <Setter Property="BorderThickness" Value="1" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding DistanceInvalid}" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Err}" />
                                    <Setter Property="BorderThickness" Value="1" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBox x:Name="DistBox" Style="{StaticResource Input.Num}" BorderThickness="0" Background="Transparent"
                             Height="26" Text="{Binding DistanceText, UpdateSourceTrigger=PropertyChanged}"
                             Tag="{Binding}" ToolTip="切换距离（HU，1 HU ≈ 1.9 厘米）；输入即生效"
                             AutomationProperties.Name="切换距离（HU）" AutomationProperties.HelpText="{Binding Error}"
                             GotKeyboardFocus="OnLevelNumberGotFocus"
                             LostKeyboardFocus="OnLevelNumberLostFocus"
                             PreviewKeyDown="OnLevelNumberKeyDown" />
                </Border>

                <Border Grid.Column="2" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,0,1,0">
                    <controls:RatioBar Margin="10,0" VerticalAlignment="Center" HorizontalAlignment="Stretch"
                                       Ratio="{Binding Ratio, Mode=TwoWay}" Maximum="{Binding MaxRatio}" Tag="{Binding}" />
                </Border>

                <Border Grid.Column="3" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,0,1,0">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="Transparent" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMouseOver, ElementName=RatioBox}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource Brush.RowHover}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=RatioBox}" Value="True">
                                    <Setter Property="Background" Value="{DynamicResource Brush.Sunken}" />
                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.FocusRing}" />
                                    <Setter Property="BorderThickness" Value="1" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding RatioInvalid}" Value="True">
                                    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Err}" />
                                    <Setter Property="BorderThickness" Value="1" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBox x:Name="RatioBox" Style="{StaticResource Input.Num}" BorderThickness="0" Background="Transparent"
                             Height="26" Text="{Binding RatioText, UpdateSourceTrigger=PropertyChanged}"
                             Tag="{Binding}" ToolTip="保留面数百分比（0.1–100）；输入即生效"
                             AutomationProperties.Name="保留面数百分比" AutomationProperties.HelpText="{Binding Error}"
                             GotKeyboardFocus="OnLevelNumberGotFocus"
                             LostKeyboardFocus="OnLevelNumberLostFocus"
                             PreviewKeyDown="OnLevelNumberKeyDown" />
                </Border>

                <Button Grid.Column="4" Style="{StaticResource Btn.Icon}" Width="24" Height="24"
                        HorizontalAlignment="Center" VerticalAlignment="Center"
                        ToolTip="删除这一级" AutomationProperties.Name="删除这一级" Click="OnRemoveLevelClick" Tag="{Binding}"
                        IsEnabled="{Binding CanRemove}">
                    <controls:Icon Kind="Close" Size="12" IconBrush="{DynamicResource Brush.InkFaint}" />
                </Button>

                <Border Grid.ColumnSpan="5" Height="1" VerticalAlignment="Bottom" Background="{DynamicResource Brush.Line}" />
            </Grid>
        </DataTemplate>

        <!-- 计划行 -->
        <DataTemplate x:Key="PlanRow" DataType="{x:Type vm:PlanQcRowVm}">
            <Border MinHeight="56" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,0,0,1"
                    Background="Transparent" ToolTipService.ShowDuration="12000">
                <Border.ToolTip>
                    <ToolTip Style="{StaticResource WrappedToolTip}" Content="{Binding Tooltip}" />
                </Border.ToolTip>
                <Grid Margin="12,6,12,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="52" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="52" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Tag="{Binding ActionTone}" Style="{StaticResource ToneDot}" Margin="0,0,5,0" />
                        <TextBlock Text="{Binding ActionText}" Tag="{Binding ActionTone}" Style="{StaticResource ToneText}"
                                   FontSize="{StaticResource FS.Small}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,10,0">
                        <TextBlock Text="{Binding QcName}" TextTrimming="CharacterEllipsis" Style="{StaticResource Text.Body}" />
                        <TextBlock Text="{Binding Summary}" TextTrimming="CharacterEllipsis" Style="{StaticResource Text.Small}"
                                   Margin="0,2,0,0" />
                    </StackPanel>
                    <TextBlock Grid.Column="2" Text="{Binding Counts}" Style="{StaticResource Text.Small}"
                               VerticalAlignment="Center" Margin="0,0,8,0" />
                    <Button Grid.Column="3" Style="{StaticResource Btn.Bare}" Content="详情" Height="28"
                            ToolTip="查看文件路径与计划详情" Click="OnPlanDetailsClick" />
                </Grid>
            </Border>
        </DataTemplate>

        <!-- 日志行 -->
        <DataTemplate x:Key="LogRow" DataType="{x:Type vm:LogLineVm}">
            <Grid Height="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="52" />
                    <ColumnDefinition Width="30" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{Binding TimeText}" Style="{StaticResource Text.Mono}" FontSize="10.5"
                           Foreground="{DynamicResource Brush.InkFaint}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="{Binding LevelText}" FontSize="10.5"
                           VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.InkFaint}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Tone}" Value="Err">
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Err}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Tone}" Value="Warn">
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Warn}" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Tone}" Value="Stage">
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Signal}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock Grid.Column="2" Text="{Binding Text}" ToolTipService.ShowDuration="12000"
                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center">
                    <TextBlock.ToolTip>
                        <ToolTip Style="{StaticResource WrappedToolTip}" Content="{Binding Text}" />
                    </TextBlock.ToolTip>
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Mono}">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.InkSoft}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsStage}" Value="True">
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Ink}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding Tone}" Value="Err">
                                    <Setter Property="Foreground" Value="{DynamicResource Brush.Err}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Border x:Name="RootBorder" BorderBrush="{DynamicResource Brush.WindowBorder}" BorderThickness="1"
                Background="{DynamicResource Brush.Canvas}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="56" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="68" />
                </Grid.RowDefinitions>

                <!-- ═══════════════════ 顶栏 ═══════════════════ -->
                <Grid Grid.Row="0" x:Name="CaptionBar">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,16,0">
                        <Viewbox Width="26" Height="26" VerticalAlignment="Center">
                            <Canvas Width="24" Height="24">
                                <!-- 品牌标记：递降阶梯 + 顶部测线 + 远点 -->
                                <Path Fill="{DynamicResource Brush.Ink}"
                                      Data="M2.8,5.4 H6.8 V19.8 H2.8 Z M6.8,8.8 H10.8 V19.8 H6.8 Z M10.8,12.2 H14.8 V19.8 H10.8 Z M14.8,15.6 H18.8 V19.8 H14.8 Z" />
                                <Rectangle Fill="{DynamicResource Brush.Ink}" Canvas.Left="2.2" Canvas.Top="21.2" Width="19.6" Height="0.9" />
                                <Path Stroke="{DynamicResource Brush.Signal}" StrokeThickness="1.4" Data="M2.4,3.4 L21.4,3.4" />
                                <Ellipse Fill="{DynamicResource Brush.Signal}" Width="2.6" Height="2.6" Canvas.Left="20.1" Canvas.Top="2.1" />
                            </Canvas>
                        </Viewbox>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                            <TextBlock Text="{x:Static local:AppInfo.ProductName}" FontSize="{StaticResource FS.Brand}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource Brush.Ink}" VerticalAlignment="Center" />
                            <Border Background="{DynamicResource Brush.Sunken}" Padding="6,1,6,2" Margin="10,1,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{x:Static local:AppInfo.DisplayVersion}" FontFamily="{StaticResource Font.Latin}" FontSize="{StaticResource FS.Micro}"
                                           Foreground="{DynamicResource Brush.InkSoft}" />
                            </Border>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                        <Button x:Name="BtnEnv" Style="{StaticResource Btn.Bare}" Click="OnEnvClick" ToolTip="{Binding EnvTip}" Margin="0,0,10,0"
                                AutomationProperties.Name="{Binding EnvText}"
                                Background="Transparent" BorderThickness="0" Padding="6,0,8,0" Height="24" Cursor="Hand"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Tag="{Binding EnvTone}" Style="{StaticResource ToneDot}" />
                                <TextBlock Text="{Binding EnvText}" Style="{StaticResource Text.Micro}" Margin="6,0,3,0"
                                           VerticalAlignment="Center" />
                                <controls:Icon Kind="ChevronRight" Size="9" IconBrush="{DynamicResource Brush.InkFaint}"
                                               VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <Button x:Name="BtnTheme" Style="{StaticResource CaptionButton}" Click="OnThemeClick" ToolTip="切换浅色 / 暗色"
                                Focusable="True" AutomationProperties.Name="切换浅色或深色" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <controls:Icon Kind="Moon" Size="14" IconBrush="{DynamicResource Brush.InkSoft}" />
                        </Button>
                        <Button x:Name="BtnMenu" Style="{StaticResource CaptionButton}" Click="OnMenuClick" ToolTip="菜单"
                                Focusable="True" AutomationProperties.Name="主菜单" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <controls:Icon Kind="Menu" Size="14" IconBrush="{DynamicResource Brush.InkSoft}" />
                        </Button>

                        <Border Width="1" Background="{DynamicResource Brush.Line}" Margin="6,17,6,17" />

                        <Button x:Name="BtnMin" Style="{StaticResource WindowButton}" Click="OnMinClick" ToolTip="最小化"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <controls:Icon Kind="Minimize" Size="12" IconBrush="{DynamicResource Brush.InkSoft}" />
                        </Button>
                        <Button x:Name="BtnMax" Style="{StaticResource WindowButton}" Click="OnMaxClick" ToolTip="最大化"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <controls:Icon Kind="Maximize" Size="11" IconBrush="{DynamicResource Brush.InkSoft}" />
                        </Button>
                        <Button x:Name="BtnClose" Style="{StaticResource WindowButtonClose}" Click="OnCloseClick" ToolTip="关闭"
                                shell:WindowChrome.IsHitTestVisibleInChrome="True">
                            <controls:Icon Kind="Close" Size="11" IconBrush="{DynamicResource Brush.InkSoft}" />
                        </Button>
                    </StackPanel>

                    <!-- 顶栏底部刻度规（量具语言，全程序只出现于此与阶梯图） -->
                    <controls:TickStrip Grid.ColumnSpan="4" Height="7" VerticalAlignment="Bottom" Margin="0,0,0,1"
                                        Step="8" TickLength="2.5" LongEvery="5" LongLength="5" />
                    <Border Grid.ColumnSpan="4" Height="1" VerticalAlignment="Bottom" Background="{DynamicResource Brush.Line}" />
                </Grid>

                <!-- ═══════════════════ 主体 ═══════════════════ -->
                <Grid Grid.Row="1" Margin="20,10,20,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition x:Name="PlanColumn" Width="400" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- 队列与计划在同一工作区切换 -->
                        <Border x:Name="QueueCard" Grid.Row="0" Background="{DynamicResource Brush.Panel}"
                                BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1">
                            <Grid>
                                <controls:CornerBrackets IsHitTestVisible="False" BracketLength="10" />
                                <Grid x:Name="QueuePane" Visibility="{Binding IsPlanVisible, Converter={StaticResource InverseBoolToVis}}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="42" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid Margin="16,0,14,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="作业队列" Style="{StaticResource Text.PageTitle}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="1" Text="{Binding Queue.SummaryText}" Style="{StaticResource Text.Small}"
                                                   TextTrimming="CharacterEllipsis" TextAlignment="Right" Margin="12,0"
                                                   Visibility="{Binding Queue.HasItems, Converter={StaticResource BoolToVis}}"
                                                   ToolTip="{Binding Queue.SummaryText}" VerticalAlignment="Center" />
                                        <Button x:Name="BtnImport" Grid.Column="2" Style="{StaticResource Btn.Secondary}" Height="28" Padding="9,0"
                                                Visibility="{Binding Queue.HasItems, Converter={StaticResource BoolToVis}}"
                                                IsEnabled="{Binding CanEdit}" Click="OnImportMenuClick" AutomationProperties.Name="导入任务">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <controls:Icon Kind="Plus" Size="12" IconBrush="{DynamicResource Brush.InkSoft}" />
                                                <TextBlock Text="导入" Margin="6,0" VerticalAlignment="Center" />
                                                <controls:Icon Kind="ChevronDown" Size="10" IconBrush="{DynamicResource Brush.InkSoft}" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                    <Border Height="1" VerticalAlignment="Bottom" Background="{DynamicResource Brush.Line}" />

                                    <Border Grid.Row="1" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,0,0,1"
                                            Visibility="{Binding Queue.HasItems, Converter={StaticResource BoolToVis}}">
                                        <Grid Margin="16,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="42" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <controls:Segmented x:Name="SegFilter" VerticalAlignment="Center"
                                                                Variant="Tabs" FontSize="11" ItemPadding="8"
                                                                AutomationProperties.Name="筛选任务状态" />
                                            <Border x:Name="SearchBox" Grid.Column="1" MaxWidth="204" Height="30"
                                                    HorizontalAlignment="Stretch" VerticalAlignment="Center">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="{DynamicResource Brush.Sunken}" />
                                                        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Line}" />
                                                        <Setter Property="BorderThickness" Value="1" />
                                                        <Style.Triggers>
                                                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                                                <Setter Property="BorderBrush" Value="{DynamicResource Brush.FocusRing}" />
                                                            </Trigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <Grid>
                                                    <controls:Icon Kind="Search" Size="13" HorizontalAlignment="Left" Margin="9,0,0,0"
                                                                   IconBrush="{DynamicResource Brush.InkSoft}" VerticalAlignment="Center" />
                                                    <TextBox x:Name="TxtSearch" Style="{StaticResource Input.Text}" BorderThickness="0" Height="Auto"
                                                             Background="Transparent" Margin="26,0,24,0" VerticalContentAlignment="Center"
                                                             Text="{Binding Queue.SearchText, UpdateSourceTrigger=PropertyChanged, Delay=150}"
                                                             AutomationProperties.Name="搜索任务名称或路径" Tag="搜索任务" />
                                                    <Button x:Name="BtnClearSearch" Width="20" Height="20" VerticalAlignment="Center"
                                                            HorizontalAlignment="Right" Margin="0,0,4,0" ToolTip="清空搜索"
                                                            AutomationProperties.Name="清空搜索" Click="OnClearSearchClick">
                                                        <Button.Style>
                                                            <Style TargetType="Button" BasedOn="{StaticResource Btn.Icon}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Text, ElementName=TxtSearch}" Value="">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Button.Style>
                                                        <controls:Icon Kind="Close" Size="11" IconBrush="{DynamicResource Brush.InkSoft}" />
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </Grid>
                                    </Border>

                                    <ListBox x:Name="QueueList" Grid.Row="2" Style="{StaticResource List.Base}"
                                             ItemTemplate="{StaticResource TaskRow}" ItemContainerStyle="{StaticResource List.Row}"
                                             ItemsSource="{Binding Queue.View}" SelectionMode="Extended"
                                             Visibility="{Binding Queue.HasItems, Converter={StaticResource BoolToVis}}"
                                             AutomationProperties.Name="作业队列"
                                             SelectionChanged="OnQueueSelectionChanged"
                                             PreviewMouseLeftButtonDown="OnQueueListPreviewMouseLeftButtonDown"
                                             MouseDoubleClick="OnQueueDoubleClick"
                                             PreviewMouseRightButtonDown="OnQueueRightButtonDown"
                                             KeyDown="OnQueueKeyDown" />

                                    <Border x:Name="EmptyState" Grid.Row="2" Background="{DynamicResource Brush.Panel}"
                                            Visibility="{Binding Queue.IsEmpty, Converter={StaticResource BoolToVis}}">
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="20,0,20,16">
                                            <controls:TickStrip Width="150" Height="9" HorizontalAlignment="Center" Step="6" TickLength="2" LongEvery="4" LongLength="4" />
                                            <TextBlock Text="队列为空" Style="{StaticResource Text.PageTitle}" HorizontalAlignment="Center" Margin="0,14,0,0" />
                                            <TextBlock Text="拖入工程文件夹、QC、GLB、SMD 或 DMX" Style="{StaticResource Text.Small}"
                                                       TextAlignment="Center" TextWrapping="Wrap" Margin="0,8,0,0" />
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,16,0,0" IsEnabled="{Binding CanEdit}">
                                                <Button x:Name="BtnEmptyImportFolder" Style="{StaticResource Btn.Secondary}" Click="OnImportFolderClick"
                                                        AutomationProperties.Name="导入文件夹">
                                                    <StackPanel Orientation="Horizontal">
                                                        <controls:Icon Kind="Folder" Size="14" IconBrush="{DynamicResource Brush.InkSoft}" />
                                                        <TextBlock Text="导入文件夹" Margin="8,0,0,0" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource Btn.Secondary}" Margin="8,0,0,0" Click="OnImportFilesClick"
                                                        AutomationProperties.Name="导入文件">
                                                    <StackPanel Orientation="Horizontal">
                                                        <controls:Icon Kind="File" Size="14" IconBrush="{DynamicResource Brush.InkSoft}" />
                                                        <TextBlock Text="导入文件" Margin="8,0,0,0" VerticalAlignment="Center" />
                                                    </StackPanel>
                                                </Button>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <Border x:Name="NoMatchState" Grid.Row="2" Background="{DynamicResource Brush.Panel}"
                                            Visibility="{Binding Queue.IsNoMatch, Converter={StaticResource BoolToVis}}">
                                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="16">
                                            <TextBlock Text="没有匹配的任务" Style="{StaticResource Text.PageTitle}" HorizontalAlignment="Center" />
                                            <Button Style="{StaticResource Btn.Secondary}" Height="30" Margin="0,12,0,0"
                                                    Content="清除筛选与搜索" HorizontalAlignment="Center" Click="OnResetFilterClick" />
                                        </StackPanel>
                                    </Border>

                                    <Border Grid.Row="3" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,1,0,0"
                                            Visibility="{Binding HasLastRun, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="{Binding LastRunText}" Style="{StaticResource Text.Small}" Margin="16,6"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding LastRunText}" />
                                    </Border>
                                </Grid>

                                <Grid x:Name="PlanOverlay" Visibility="{Binding IsPlanVisible, Converter={StaticResource BoolToVis}}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="42" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>
                                    <Border BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,0,0,1">
                                        <DockPanel Margin="16,0,14,0">
                                            <Button x:Name="BtnClosePlan" DockPanel.Dock="Right" Style="{StaticResource Btn.Bare}" Height="28"
                                                    AutomationProperties.Name="返回队列" IsEnabled="{Binding CanEdit}" Click="OnClosePlanClick" ToolTip="返回队列（Esc）">
                                                <StackPanel Orientation="Horizontal">
                                                    <controls:Icon Kind="ChevronLeft" Size="11" IconBrush="{DynamicResource Brush.InkSoft}" />
                                                    <TextBlock Text="返回队列" Margin="5,0,0,0" />
                                                </StackPanel>
                                            </Button>
                                            <TextBlock Text="作业计划" Style="{StaticResource Text.PageTitle}" VerticalAlignment="Center" />
                                        </DockPanel>
                                    </Border>

                                    <StackPanel Grid.Row="1" Margin="16,12,16,10">
                                        <TextBlock Text="{Binding PlanPreview.Headline}" Style="{StaticResource Text.Section}"
                                                   TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding PlanPreview.Subline}" Style="{StaticResource Text.Small}" Margin="0,3,0,0"
                                                   Visibility="{Binding PlanPreview.HasBreakdown, Converter={StaticResource BoolToVis}}" />
                                        <Border Background="{DynamicResource Brush.Sunken}" BorderBrush="{DynamicResource Brush.Line}"
                                                BorderThickness="1" Padding="10,7" Margin="0,9,0,0">
                                            <StackPanel>
                                                <TextBlock Text="{Binding PlanPreview.LevelsText}" Style="{StaticResource Text.Small}"
                                                           Foreground="{DynamicResource Brush.Ink}" TextWrapping="Wrap"
                                                           ToolTip="{Binding PlanPreview.LevelsText}" />
                                                <TextBlock Text="{Binding PlanPreview.WriteText}" Style="{StaticResource Text.Small}"
                                                           TextWrapping="Wrap" Margin="0,3,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>

                                    <Border x:Name="StalePlanNotice" Grid.Row="2" Margin="16,0,16,10" Padding="9,6"
                                            BorderThickness="2,0,0,0" BorderBrush="{DynamicResource Brush.Warn}"
                                            Background="{DynamicResource Brush.WarnSoft}"
                                            Visibility="{Binding PlanPreview.IsStale, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="预览已过期。重新扫描可更新档位、写入方式和任务清单。"
                                                   Style="{StaticResource Text.Small}" Foreground="{DynamicResource Brush.Warn}" TextWrapping="Wrap" />
                                    </Border>

                                    <Border Grid.Row="3" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,1,0,0">
                                        <Grid>
                                            <ListBox x:Name="PlanList" Style="{StaticResource List.Base}" ItemsSource="{Binding PlanPreview.Rows}"
                                                     ItemTemplate="{StaticResource PlanRow}" ItemContainerStyle="{StaticResource List.Row}"
                                                     AutomationProperties.Name="计划任务" KeyDown="OnPlanListKeyDown"
                                                     IsEnabled="{Binding CanEdit}" />
                                            <TextBlock Text="没有扫描到作业。可展开日志查看原因。" Style="{StaticResource Text.Small}"
                                                       TextWrapping="Wrap" TextAlignment="Center" Margin="16"
                                                       VerticalAlignment="Center" HorizontalAlignment="Center"
                                                       Visibility="{Binding PlanPreview.IsEmpty, Converter={StaticResource BoolToVis}}" />
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- ───── 运行日志 ───── -->
                        <Border x:Name="LogCard" Grid.Row="2" Height="44" Background="{DynamicResource Brush.Panel}"
                                BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" ClipToBounds="True">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="42" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="16,0,10,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button x:Name="BtnToggleLog" Style="{StaticResource Btn.Bare}" Padding="0,0,5,0" Height="30"
                                            VerticalAlignment="Center" Click="OnToggleLogClick" ToolTip="展开或折叠日志（Ctrl+L）"
                                            AutomationProperties.Name="展开或折叠运行日志">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="运行日志" Style="{StaticResource Text.Section}" VerticalAlignment="Center" />
                                            <controls:Icon x:Name="LogChevron" Kind="ChevronDown" Size="12" Margin="6,0,0,0"
                                                           IconBrush="{DynamicResource Brush.InkSoft}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <TextBlock Grid.Column="1" Text="{Binding Log.CountText}" Style="{StaticResource Text.Small}"
                                               TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="8,0"
                                               ToolTip="{Binding Log.CountText}" />
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                        <controls:Segmented x:Name="SegLogFilter" Variant="Tabs" FontSize="11" ItemPadding="8"
                                                            AutomationProperties.Name="筛选日志级别" />
                                        <Border Width="1" Height="14" Background="{DynamicResource Brush.Line}" Margin="10,0,8,0" />
                                        <Button Style="{StaticResource Btn.Bare}" AutomationProperties.Name="复制日志" Click="OnCopyLogClick"
                                                IsEnabled="{Binding Log.HasLines}" ToolTip="复制当前显示的日志">
                                            <TextBlock Text="复制" FontSize="{StaticResource FS.Micro}" />
                                        </Button>
                                        <Button Style="{StaticResource Btn.Bare}" AutomationProperties.Name="清空日志" Click="OnClearLogClick"
                                                IsEnabled="{Binding Log.HasLines}" ToolTip="清空日志">
                                            <TextBlock Text="清空" FontSize="{StaticResource FS.Micro}" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                                <Border Grid.Row="0" Height="1" VerticalAlignment="Bottom" Background="{DynamicResource Brush.Line}" />

                                <Grid x:Name="LogBody" Grid.Row="1" Visibility="Collapsed">
                                    <ListBox x:Name="LogList" Style="{StaticResource List.Base}" ItemsSource="{Binding Log.View}"
                                             ItemTemplate="{StaticResource LogRow}" ItemContainerStyle="{StaticResource List.Row}"
                                             Padding="16,4,10,6" KeyDown="OnLogKeyDown" AutomationProperties.Name="运行日志内容"
                                             ScrollViewer.VerticalScrollBarVisibility="Auto" />
                                    <TextBlock Text="{Binding Log.EmptyText}" Style="{StaticResource Text.Small}" HorizontalAlignment="Center"
                                               VerticalAlignment="Center" IsHitTestVisible="False"
                                               Visibility="{Binding Log.IsEmpty, Converter={StaticResource BoolToVis}}" />
                                    <Button x:Name="BtnNewLogs" Style="{StaticResource Btn.Primary}" Height="26" Padding="10,0,10,0"
                                            HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,18,8"
                                            Visibility="{Binding Log.HasNew, Converter={StaticResource BoolToVis}}"
                                            Click="OnResumeFollowClick">
                                        <TextBlock Text="{Binding Log.NewCount, StringFormat={}{0} 条新日志}" FontSize="{StaticResource FS.Micro}" />
                                    </Button>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- LOD 方案的档位区域独立滚动，底部写入方式始终可用 -->
                    <Border Grid.Column="2" Background="{DynamicResource Brush.Panel}"
                            BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1" IsEnabled="{Binding CanEdit}">
                        <Grid Margin="16,0,16,8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="42" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <DockPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                    <ComboBox x:Name="CmbPreset" Style="{StaticResource Combo.Base}" Width="152"
                                              AutomationProperties.Name="LOD 预设" SelectionChanged="OnPresetSelectionChanged"
                                              ToolTip="选择固定预设、自定义或自动估算" />
                                    <Button Style="{StaticResource Btn.Bare}" Margin="4,0,0,0" Click="OnRestorePresetClick"
                                            IsEnabled="{Binding LodPlan.ShowRestore}" ToolTip="恢复修改前的预设" Content="恢复" />
                                </StackPanel>
                                <TextBlock Text="LOD 方案" Style="{StaticResource Text.PageTitle}" VerticalAlignment="Center" />
                            </DockPanel>
                            <Border Height="1" VerticalAlignment="Bottom" Background="{DynamicResource Brush.Line}" />

                            <ScrollViewer x:Name="LodEditor" Grid.Row="1" Margin="0,6,0,0"
                                          HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Focusable="False">
                                <Grid>
                                    <StackPanel x:Name="LodTableHost" Visibility="{Binding LodPlan.IsAutomatic, Converter={StaticResource InverseBoolToVis}}">
                                        <Border x:Name="LodTopFrame" Height="1" Background="{DynamicResource Brush.LineStrong}" />
                                        <Border BorderBrush="{DynamicResource Brush.LineStrong}" BorderThickness="1,0,1,0">
                                            <StackPanel>
                                                <Grid Height="26" Background="{DynamicResource Brush.Sunken}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="34" />
                                                        <ColumnDefinition Width="82" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="82" />
                                                        <ColumnDefinition Width="28" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,0,1,0">
                                                        <TextBlock Text="级别" Style="{StaticResource Text.Small}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <Border Grid.Column="1" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,0,1,0">
                                                        <TextBlock Text="距离 HU" Style="{StaticResource Text.Small}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <Border Grid.Column="2" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,0,1,0">
                                                        <TextBlock Text="保留比例" Style="{StaticResource Text.Small}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <Border Grid.Column="3" BorderBrush="{DynamicResource Brush.Line}" BorderThickness="0,0,1,0">
                                                        <TextBlock Text="比例 %" Style="{StaticResource Text.Small}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                    </Border>
                                                    <Border Grid.ColumnSpan="5" Height="1" VerticalAlignment="Bottom" Background="{DynamicResource Brush.Line}" />
                                                </Grid>
                                                <ItemsControl x:Name="LevelList" ItemsSource="{Binding LodPlan.Levels}" ItemTemplate="{StaticResource LevelRow}" />
                                            </StackPanel>
                                        </Border>
                                        <Border x:Name="LodBottomFrame" Height="1" Background="{DynamicResource Brush.LineStrong}" />
                                        <Button Style="{StaticResource Btn.Secondary}" Height="32" Margin="0,6,0,0"
                                                AutomationProperties.Name="添加一级" Click="OnAddLevelClick"
                                                Visibility="{Binding LodPlan.CanAddLevel, Converter={StaticResource BoolToVis}}">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                <controls:Icon Kind="Plus" Size="12" IconBrush="{DynamicResource Brush.InkSoft}" />
                                                <TextBlock Text="添加一级" Margin="6,0,0,0" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>

                                    <Border x:Name="AutomaticHint" VerticalAlignment="Top" Margin="0,6,0,6" Padding="12,10" BorderThickness="1"
                                            BorderBrush="{DynamicResource Brush.Line}" Background="{DynamicResource Brush.Sunken}"
                                            Visibility="{Binding LodPlan.IsAutomatic, Converter={StaticResource BoolToVis}}">
                                        <StackPanel>
                                            <TextBlock Text="扫描后自动估算" Style="{StaticResource Text.Section}" />
                                            <TextBlock Text="扫描会按模型估算候选档位和保留比例。生成报告会列出实际面数与切换距离。"
                                                       Style="{StaticResource Text.Small}" TextWrapping="Wrap" Margin="0,5,0,0" />
                                            <Border Height="1" Background="{DynamicResource Brush.Line}" Margin="0,10" />
                                            <TextBlock Text="自动备份并写入有效档位。单独导入模型时只生成 LOD 网格。"
                                                       Style="{StaticResource Text.Small}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </ScrollViewer>

                            <StackPanel Grid.Row="2" Margin="0,10,0,0"
                                        Visibility="{Binding LodPlan.IsAutomatic, Converter={StaticResource InverseBoolToVis}}">
                                <TextBlock x:Name="LodValidation" Text="{Binding LodPlan.ValidationError}" Style="{StaticResource Text.Small}"
                                           Foreground="{DynamicResource Brush.Err}" TextWrapping="Wrap" Margin="0,0,0,8"
                                           Visibility="{Binding LodPlan.IsValid, Converter={StaticResource InverseBoolToVis}}" />
                                <Border x:Name="WriteSeparator" Height="1" Background="{DynamicResource Brush.Line}" />
                                <TextBlock Text="写入方式" Style="{StaticResource Text.Small}" Margin="0,8,0,5" />
                                <controls:Segmented x:Name="SegWriteMode" Variant="Boxed" EqualWidths="True"
                                                    HorizontalAlignment="Stretch" FontSize="{StaticResource FS.Small}" ItemPadding="7" Height="30"
                                                    AutomationProperties.Name="QC 写入方式" ToolTip="{Binding LodPlan.WriteModeHint}" />
                                <TextBlock Text="{Binding LodPlan.WriteModeHint}" Style="{StaticResource Text.Small}"
                                           TextWrapping="Wrap" Margin="0,6,0,0" />
                            </StackPanel>

                            <StackPanel Grid.Row="3" Margin="0,10,0,0">
                                <Border Height="1" Background="{DynamicResource Brush.Line}" />
                                <Button Style="{StaticResource Btn.Secondary}" Height="42" Margin="0,8,0,0" Padding="10,0"
                                        AutomationProperties.Name="高级参数" Click="OnAdvancedClick"
                                        HorizontalContentAlignment="Stretch" ToolTip="{Binding AdvancedSummary}">
                                    <DockPanel>
                                        <controls:Icon DockPanel.Dock="Right" Kind="ChevronRight" Size="11" IconBrush="{DynamicResource Brush.InkSoft}"
                                                       Margin="8,0,0,0" VerticalAlignment="Center" />
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="高级参数" Style="{StaticResource Text.Body}" />
                                            <TextBlock Text="{Binding AdvancedSummary}" TextTrimming="CharacterEllipsis" Style="{StaticResource Text.Small}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!-- ═══════════════════ HUD ═══════════════════ -->
                <Border Grid.Row="2" Margin="20,0,20,12" Background="{DynamicResource Brush.Panel}"
                        BorderBrush="{DynamicResource Brush.Line}" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="3" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <controls:SegmentedProgress x:Name="Progress" Grid.Row="0" Height="3"
                                                    Value="{Binding ProgressValue}" IsIndeterminate="{Binding ProgressIndeterminate}"
                                                    Failed="{Binding ProgressFailed}" Visibility="{Binding ProgressVisible, Converter={StaticResource BoolToVis}}" />
                        <Grid Grid.Row="1" Margin="16,0,12,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Grid VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="13" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Ellipse Tag="{Binding StatusTone}" Style="{StaticResource ToneDot}" HorizontalAlignment="Left" />
                                <TextBlock x:Name="StatusTitle" Grid.Column="1" Text="{Binding StatusTitle}" Style="{StaticResource Text.Section}"
                                           TextTrimming="CharacterEllipsis" AutomationProperties.LiveSetting="Polite" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding StatusSub}" Style="{StaticResource Text.Small}"
                                           Margin="0,2,0,0" TextTrimming="CharacterEllipsis" TextWrapping="Wrap"
                                           MaxHeight="30" LineHeight="15" LineStackingStrategy="BlockLineHeight">
                                    <TextBlock.ToolTip>
                                        <ToolTip Style="{StaticResource WrappedToolTip}" Content="{Binding StatusSub}" />
                                    </TextBlock.ToolTip>
                                </TextBlock>
                            </Grid>

                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,18,0">
                                <TextBlock Text="{Binding ReadoutMainText}" Style="{StaticResource Text.Readout}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding ReadoutSub}" Style="{StaticResource Text.Small}" Margin="6,9,0,0" VerticalAlignment="Center" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="BtnShowIssues" Style="{StaticResource Btn.Bare}" Height="34" Margin="0,0,6,0"
                                        Visibility="{Binding ShowResultLog, Converter={StaticResource BoolToVis}}" Click="OnOpenErrorLogClick"
                                        Content="查看日志" />
                                <Button x:Name="BtnOpenReport" Style="{StaticResource Btn.Secondary}" Height="34" Margin="0,0,8,0"
                                        Visibility="{Binding CanOpenLastReport, Converter={StaticResource BoolToVis}}"
                                        AutomationProperties.Name="打开报告" Click="OnOpenReportClick" ToolTip="打开上次的运行报告">
                                    <StackPanel Orientation="Horizontal">
                                        <controls:Icon Kind="Report" Size="13" IconBrush="{DynamicResource Brush.InkSoft}" />
                                        <TextBlock Text="报告" Margin="7,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnOpenFolder" Style="{StaticResource Btn.Secondary}" Height="34" Margin="0,0,12,0"
                                        Visibility="{Binding CanOpenOutputFolder, Converter={StaticResource BoolToVis}}"
                                        AutomationProperties.Name="打开产物目录" Click="OnOpenFolderClick" ToolTip="打开本次产物所在目录">
                                    <StackPanel Orientation="Horizontal">
                                        <controls:Icon Kind="Folder" Size="13" IconBrush="{DynamicResource Brush.InkSoft}" />
                                        <TextBlock Text="产物目录" Margin="7,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnPreview" Style="{StaticResource Btn.Secondary}" Height="34" MinWidth="104"
                                        Visibility="{Binding ShowStartButton, Converter={StaticResource BoolToVis}}"
                                        IsEnabled="{Binding CanPreview}" Click="OnPreviewClick"
                                        AutomationProperties.Name="{Binding PreviewButtonText}" ToolTip="读取 QC 和模型，列出档位、写入方式和跳过原因">
                                    <StackPanel Orientation="Horizontal">
                                        <controls:Icon Kind="Scan" Size="13" IconBrush="{DynamicResource Brush.InkSoft}" />
                                        <TextBlock Text="{Binding PreviewButtonText}" Margin="7,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnStart" Style="{StaticResource Btn.Primary}" Height="34" MinWidth="116" Margin="8,0,0,0"
                                        Visibility="{Binding ShowStartButton, Converter={StaticResource BoolToVis}}"
                                        IsEnabled="{Binding CanStart}" Click="OnStartClick" AutomationProperties.Name="{Binding StartButtonText}"
                                        ToolTip="{Binding StartHint}" ToolTipService.ShowOnDisabled="True">
                                    <StackPanel Orientation="Horizontal">
                                        <controls:Icon Kind="Play" Size="11" IconBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                        <TextBlock Text="{Binding StartButtonText}" Margin="7,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnStop" Style="{StaticResource Btn.Danger}" Height="34" MinWidth="116"
                                        Visibility="{Binding ShowStopButton, Converter={StaticResource BoolToVis}}"
                                        IsEnabled="{Binding IsStopping, Converter={StaticResource InverseBoolToVis}}"
                                        AutomationProperties.Name="{Binding StopButtonText}" Click="OnStopClick" ToolTip="取消或停止（Esc）">
                                    <StackPanel Orientation="Horizontal">
                                        <controls:Icon Kind="Stop" Size="11" IconBrush="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" />
                                        <TextBlock Text="{Binding StopButtonText}" Margin="7,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Border>

        <!-- 菜单打开时的透明点击捕获层：点窗口任意处（包括再点一次 ☰）都关闭菜单 -->
        <Border x:Name="MenuCatcher" Background="Transparent" Visibility="Collapsed" Panel.ZIndex="50"
                MouseLeftButtonDown="OnMenuCatcherClick" />

        <!-- ═══════════════════ 覆盖层：拖放高亮 / 对话框 / Toast ═══════════════════ -->
        <Border x:Name="DropOverlay" Background="#55000000" Visibility="Collapsed" IsHitTestVisible="False">
            <Border Margin="40" Background="{DynamicResource Brush.Panel}" BorderBrush="{DynamicResource Brush.Signal}"
                    BorderThickness="2" Opacity="0.98">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <controls:Icon Kind="Folder" Size="44" IconBrush="{DynamicResource Brush.Signal}" HorizontalAlignment="Center" />
                    <TextBlock Text="松开加入任务" Style="{StaticResource Text.PageTitle}" HorizontalAlignment="Center" Margin="0,14,0,0" />
                    <TextBlock x:Name="DropHint" Text="支持工程文件夹 / QC / GLB / SMD / DMX" Style="{StaticResource Text.Small}"
                               HorizontalAlignment="Center" Margin="0,6,0,0" />
                </StackPanel>
            </Border>
        </Border>

        <controls:ToastHost x:Name="Toasts" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,92"
                            Width="360" Height="200" />

        <controls:DialogHost x:Name="Dialogs" />
    </Grid>
</Window>
