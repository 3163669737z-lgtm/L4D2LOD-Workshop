<Window x:Class="LodStudio.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:controls="clr-namespace:LodStudio.Controls"
        Title="设置 · 远景工坊"
        Width="960" Height="660" MinWidth="900" MinHeight="600"
        WindowStyle="None" ResizeMode="CanResize" WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource Brush.Canvas}"
        FontFamily="{StaticResource Font.Cjk}" FontSize="{StaticResource FS.Body}"
        Foreground="{DynamicResource Brush.Ink}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Ideal" TextOptions.TextRenderingMode="ClearType">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="48" ResizeBorderThickness="6"
                            CornerRadius="0" GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Views/Settings/SettingsKit.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border x:Name="RootBorder" Background="{DynamicResource Brush.Canvas}"
            BorderBrush="{DynamicResource Brush.WindowBorder}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="48" />
                <RowDefinition Height="*" />
                <RowDefinition Height="56" />
            </Grid.RowDefinitions>

            <!-- ═══════════════════ 标题栏（WindowChrome CaptionHeight=48） ═══════════════════ -->
            <Grid Grid.Row="0" Background="{DynamicResource Brush.Canvas}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center"
                            Margin="16,0,0,0">
                    <Border Width="4" Height="18" Background="{DynamicResource Brush.Signal}" VerticalAlignment="Center" />
                    <TextBlock Text="设置" Style="{StaticResource Text.PageTitle}" Margin="10,0,0,0"
                               VerticalAlignment="Center" />
                    <TextBlock Text="PREFERENCES" FontFamily="{StaticResource Font.Latin}"
                               FontSize="{StaticResource FS.BrandLatin}" Foreground="{DynamicResource Brush.InkFaint}"
                               Margin="10,3,0,0" VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,0,4,0">
                    <!-- "已保存"脉冲：固定宽度容器，出现/消失不挤动关闭按钮 -->
                    <Grid x:Name="SavedHost" Width="112" Height="24" VerticalAlignment="Center"
                          IsHitTestVisible="False">
                        <Border x:Name="SavedPill" HorizontalAlignment="Right" VerticalAlignment="Center"
                                Background="{DynamicResource Brush.OkSoft}" Padding="8,2,8,2" Opacity="0">
                            <StackPanel Orientation="Horizontal">
                                <controls:Icon x:Name="SavedIcon" Kind="Check" Size="10"
                                               IconBrush="{DynamicResource Brush.Ok}" VerticalAlignment="Center" />
                                <TextBlock x:Name="SavedText" Text="已保存" FontSize="{StaticResource FS.Micro}"
                                           Foreground="{DynamicResource Brush.Ok}" Margin="5,0,0,0"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <Border Width="1" Height="20" Background="{DynamicResource Brush.Line}" Margin="2,0,10,0" />
                    <Button x:Name="BtnCloseWindow" Style="{StaticResource WindowButtonClose}" Width="40" Height="40"
                            Click="OnCloseClick" ToolTip="关闭（Esc）"
                            shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <controls:Icon Kind="Close" Size="11" IconBrush="{DynamicResource Brush.InkSoft}" />
                    </Button>
                </StackPanel>

                <Border Height="1" VerticalAlignment="Bottom" Background="{DynamicResource Brush.Line}" />
            </Grid>

            <!-- ═══════════════════ 主体：左导航 + 右侧内容 ═══════════════════ -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="208" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Background="{DynamicResource Brush.Panel}">
                    <ListBox x:Name="NavList" Style="{StaticResource Set.NavList}" Margin="0,8,0,0" />
                </Border>
                <Border Grid.Column="1" Background="{DynamicResource Brush.Line}" />

                <ScrollViewer x:Name="PageScroll" Grid.Column="2" Background="{DynamicResource Brush.Panel}"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Focusable="False" Padding="24,20,24,28">
                    <Grid x:Name="PageHost" MaxWidth="620" HorizontalAlignment="Left" />
                </ScrollViewer>
            </Grid>

            <!-- ═══════════════════ 底栏 ═══════════════════ -->
            <Grid Grid.Row="2" Background="{DynamicResource Brush.Canvas}">
                <Border Height="1" VerticalAlignment="Top" Background="{DynamicResource Brush.Line}" />
                <TextBlock Text="改动即时生效；窗口可以一直开着，边调边看主界面" Style="{StaticResource Text.Small}"
                           Margin="20,0,240,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,0,20,0">
                    <Button x:Name="BtnOpenSettingsFolder" Style="{StaticResource Btn.Ghost}" Height="30"
                            Padding="10,0,10,0" Click="OnOpenSettingsFolderClick">
                        <StackPanel Orientation="Horizontal">
                            <controls:Icon Kind="Folder" Size="13" IconBrush="{DynamicResource Brush.InkSoft}" />
                            <TextBlock Text="打开设置文件夹" Margin="7,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="BtnCloseFooter" Style="{StaticResource Btn.Secondary}" Width="96" Height="30"
                            Content="关闭" Margin="8,0,0,0" Click="OnCloseClick" />
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
