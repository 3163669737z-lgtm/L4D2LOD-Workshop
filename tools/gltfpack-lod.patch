+			if (allow_vertex_updates)
+				for (unsigned int source : region.source_vertices)
+					seam_locks.push_back(seam_flags[position_ids[source]]);
+			bool deep = density_budget ? region.target * 3 < region.indices.size() * 0.65 : ratio < 0.65f;
+			region.candidate = lodstudio::reduce(indices, geometry, weights, outline_locks, std::move(hard_locks),
