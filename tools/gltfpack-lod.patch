+			size_t triangles = indices.size() / 3;
+			double legacy_strength = std::min(1.0, sqrt(double(triangles) / 512));
+			double weight = lodstudio::componentBudgetWeight(island.size() / 3, mesh.indices.size() / 3);
+			double retention = density_budget ? lodstudio::islandRetention(weight, ratio)
+				: 1 - (1 - ratio) * legacy_strength;
+			region.target = triangles <= (density_budget ? 1 : 32) ? triangles : size_t(ceil(triangles * retention));
+			if (shadow_mode)
+				region.target = triangles <= 8 ? triangles : size_t(ceil(triangles * ratio));
+			else if (density_budget)
+			{
