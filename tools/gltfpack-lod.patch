-static void simplifyMesh(Mesh& mesh, float threshold, float error, bool aggressive, bool lock_borders, bool permissive, bool update)
+// Simplify disconnected triangle islands separately. Use position IDs for connectivity
+// across split UV/normal vertices without welding their distinct attributes.
+static size_t islandRoot(std::vector<size_t>& parents, size_t i)
+{
+	while (parents[i] != i)
+	{
+		parents[i] = parents[parents[i]];
+		i = parents[i];
+	}
+	return i;
+}
+
+static std::vector<std::vector<unsigned int> > findTriangleIslands(
+	const std::vector<unsigned int>& indices, const std::vector<unsigned int>& position_ids)
+{
+	size_t triangle_count = indices.size() / 3;
+	std::vector<size_t> parents(triangle_count);
+	std::unordered_map<uint64_t, size_t> edges;
+	edges.reserve(indices.size());
+	for (size_t i = 0; i < triangle_count; ++i)
+	{
+		parents[i] = i;
+		for (size_t k = 0; k < 3; ++k)
+		{
+			unsigned int a = position_ids[indices[i * 3 + k]];
+			unsigned int b = position_ids[indices[i * 3 + (k + 1) % 3]];
+			if (a == b)
+				continue;
+			uint64_t key = (uint64_t(std::min(a, b)) << 32) | std::max(a, b);
+			auto edge = edges.emplace(key, i);
+			if (!edge.second)
+				parents[islandRoot(parents, i)] = islandRoot(parents, edge.first->second);
+		}
+	}
+
+	std::vector<std::vector<unsigned int> > islands;
+	std::vector<size_t> slots(triangle_count, size_t(-1));
+	for (size_t i = 0; i < triangle_count; ++i)
+	{
+		size_t& slot = slots[islandRoot(parents, i)];
+		if (slot == size_t(-1))
+		{
+			slot = islands.size();
+			islands.emplace_back();
+		}
+		islands[slot].insert(islands[slot].end(), indices.begin() + i * 3, indices.begin() + i * 3 + 3);
+	}
+	return islands;
+}
+
+static std::vector<unsigned char> lockOutlineSupports(const std::vector<Attr>& positions)
+{
+	std::vector<unsigned char> locks(positions.size());
+	// Preserve extrema along axes, face diagonals and body diagonals, in both directions.
+	for (int x = 0; x <= 1; ++x)
+		for (int y = -1; y <= 1; ++y)
+			for (int z = -1; z <= 1; ++z)
+			{
+				if (x == 0 && (y < 0 || (y == 0 && z <= 0)))
+					continue;
+
+				float min_dot = 0, max_dot = 0;
+				size_t min_vertex = 0, max_vertex = 0;
+				for (size_t i = 0; i < positions.size(); ++i)
+				{
+					const float* p = positions[i].f;
+					float dot = x * p[0] + y * p[1] + z * p[2];
+					if (i == 0 || dot < min_dot) { min_dot = dot; min_vertex = i; }
+					if (i == 0 || dot > max_dot) { max_dot = dot; max_vertex = i; }
+				}
+				if (min_dot != max_dot)
+					locks[min_vertex] = locks[max_vertex] = meshopt_SimplifyVertex_Lock;
+			}
+	return locks;
+}
+
+static bool hasIndependentPrimitiveBorders(const cgltf_node* node, const Stream* current)
+{
+	if (!node || !node->mesh || node->mesh->primitives_count < 2)
+		return true;
+
+	std::vector<float> positions;
+	std::vector<size_t> offsets(1, 0);
+	for (size_t i = 0; i < node->mesh->primitives_count; ++i)
+	{
+		const cgltf_accessor* accessor = cgltf_find_accessor(&node->mesh->primitives[i], cgltf_attribute_type_position, 0);
+		if (!accessor || accessor->type != cgltf_type_vec3)
+			return false;
+
+		size_t offset = positions.size();
+		size_t count = accessor->count * 3;
+		positions.resize(offset + count);
+		if (count && cgltf_accessor_unpack_floats(accessor, positions.data() + offset, count) != count)
+			return false;
+		offsets.push_back(positions.size() / 3);
+	}
+
+	if (positions.empty())
+		return false;
+	size_t source_count = positions.size() / 3;
+	if (current)
+		for (const Attr& p : current->data)
+			positions.insert(positions.end(), p.f, p.f + 3);
+
+	std::vector<unsigned int> remap(positions.size() / 3);
+	meshopt_generatePositionRemap(remap.data(), positions.data(), remap.size(), 3 * sizeof(float));
+	std::vector<unsigned char> shared(current ? source_count : 0);
+	for (size_t i = 1; i < offsets.size(); ++i)
+		for (size_t j = offsets[i - 1]; j < offsets[i]; ++j)
+			if (remap[j] < offsets[i - 1])
+			{
+				if (!current)
+					return false;
+				shared[remap[j]] = 1;
+			}
+
+	for (size_t i = source_count; i < remap.size(); ++i)
+		if (remap[i] >= source_count || shared[remap[i]])
+			return false;
+	return true;
+}
+
+static void simplifyIslands(std::vector<unsigned int>& result, std::vector<unsigned int>& uvremap,
+	Mesh& mesh, const Stream& positions, const std::vector<float>& attributes, const float* weights,
+	size_t stride, float ratio, float error, unsigned int options, bool allow_vertex_updates, bool density_budget,
+	float lod_progress, int fidelity_mode, bool shadow_mode)
+{
+	struct Region
+	{
+		std::vector<unsigned int> indices;
+		std::vector<unsigned int> source_vertices;
+		lodstudio::ValidationResult candidate;
+		size_t target = 0;
+		size_t stage_minimum = 0;
+		float density_priority = 0;
+		float detail_strength = 0;
+		bool balanced = false;
+
+		size_t kept() const { return candidate.indices.empty() ? indices.size() : candidate.indices.size(); }
+		double retention() const { return double(kept()) / indices.size(); }
+	};
+
+	result.clear();
+	result.reserve(mesh.indices.size());
+	std::vector<unsigned int> position_ids(positions.data.size());
+	meshopt_generatePositionRemap(position_ids.data(), positions.data[0].f, positions.data.size(), sizeof(Attr));
+	std::vector<std::vector<unsigned int> > islands = findTriangleIslands(mesh.indices, position_ids);
+	lodstudio::Bounds mesh_bounds;
+	if (density_budget)
+		for (const Attr& p : positions.data)
+			mesh_bounds.include(lodstudio::xyz(p));
+	float mesh_scale = mesh_bounds.extent();
+	float far_strength = density_budget ? lodstudio::farStrength(lod_progress) : 0.f;
+
+	// A primitive boundary can be stitched to a neighboring material.
+	bool shared_material_borders = (density_budget || shadow_mode) && std::any_of(mesh.nodes.begin(), mesh.nodes.end(), [](const cgltf_node* node) {
+		return node && node->mesh && node->mesh->primitives_count > 1;
+	});
+
+	// In the far tiers, allow an independent primitive to simplify its own
+	// outlines even if two other primitives of the node share an edge.
+	const Stream* current = far_strength > 0 ? &positions : NULL;
+	bool independent_material_borders = lod_progress >= 0 && shared_material_borders &&
+		std::all_of(mesh.nodes.begin(), mesh.nodes.end(), [current](const cgltf_node* node) {
+			return hasIndependentPrimitiveBorders(node, current);
+		});
+
+	std::vector<Region> regions;
+	std::vector<size_t> island_offsets(1, 0);
+	size_t total_target = 0;
+	for (const auto& island : islands)
+	{
+		float detail_strength = 0.f;
+		if (far_strength > 0 && std::isfinite(mesh_scale) && mesh_scale > 0)
+		{
+			lodstudio::Bounds bounds;
+			for (unsigned int vertex : island)
+				bounds.include(lodstudio::xyz(positions.data[vertex]));
+			float fraction = bounds.extent() / mesh_scale;
+			detail_strength = far_strength * std::max(0.f, std::min(1.f, (0.09f - fraction) / 0.07f));
+		}
