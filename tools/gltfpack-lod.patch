+			if (index == ~0u)
+			{
+				index = unsigned(local_positions.size());
+				local_positions.push_back(positions.data[source]);
+				local_attributes.insert(local_attributes.end(), attributes.begin() + source * stride, attributes.begin() + (source + 1) * stride);
